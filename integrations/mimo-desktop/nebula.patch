+    expect(configSchema.safeParse(config).success).toBe(false)
+  })
+  test("local MCP migrates, validates executable paths and keeps argument boundaries", () => {
+    const previous = JSON.parse(JSON.stringify(defaultConfig()))
+    delete previous.localMCP
