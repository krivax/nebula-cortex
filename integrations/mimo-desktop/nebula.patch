+import { expect, test } from "bun:test"
+import { projectRelative, nodeExecutable, engineExecutable } from "./platform"
+
+test("recusa escapes de projeto com barras POSIX e preserva subpastas", () => {
+  expect(projectRelative("/tmp/example", "/tmp/example/src/example.ts", "linux")).toBe("src/example.ts")
+  expect(() => projectRelative("/tmp/example", "/tmp/other/example.ts", "linux")).toThrow()
+  expect(() => projectRelative("/tmp/example", "/tmp/example", "linux")).toThrow()
+})
+test("recusa escapes Windows, outras unidades e shares UNC", () => {
+  expect(projectRelative("C:\\example", "C:\\example\\src\\example.ts", "win32")).toBe("src\\example.ts")
+  expect(() => projectRelative("C:\\example", "C:\\other\\example.ts", "win32")).toThrow()
+  expect(() => projectRelative("C:\\example", "D:\\example.ts", "win32")).toThrow()
