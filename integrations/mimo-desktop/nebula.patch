+test("editar a missão preparada atualiza o rascunho e a missão ativa", () => {
+  prepareMission(mission)
+  const edited = { ...mission, objective: "Objetivo revisado", prompt: "Solicitação revisada", updated: 2 }
+  refreshMission(edited)
+  expect(activeMission()).toEqual(edited)
+  expect(pendingTaskDraft()?.prompt).toBe("Solicitação revisada")
+})
+test("remover a missão preparada limpa o vínculo e invalida o rascunho", () => {
+  prepareMission(mission)
+  const revision = draftRevision()
+  forgetMission(mission.id)
+  expect(activeMission()).toBeUndefined()
+  expect(pendingTaskDraft()).toBeUndefined()
+  expect(draftRevision()).toBe(revision + 1)
+})
+test("gerenciar outra missão preserva o rascunho em edição", () => {
+  prepareMission(mission)
+  const revision = draftRevision()
+  refreshMission({ ...mission, id: "22222222-2222-4222-8222-222222222222" })
+  forgetMission("22222222-2222-4222-8222-222222222222")
+  expect(pendingTaskDraft()).toEqual(mission)
+  expect(draftRevision()).toBe(revision)
+})
+test("remover missão vinculada preserva o texto independente da conversa", () => {
+  prepareMission({ ...mission, sessionID: "test_session" })
+  const revision = draftRevision()
+  refreshMission({ ...mission, sessionID: "test_session", objective: "Objetivo revisado" })
+  expect(activeMission()?.objective).toBe("Objetivo revisado")
+  expect(pendingTaskDraft()).toBeUndefined()
+  forgetMission(mission.id)
+  expect(activeMission()).toBeUndefined()
+  expect(draftRevision()).toBe(revision)
+})
