diff --git a/packages/desktop/src/nebula/reflex-client.ts b/packages/desktop/src/nebula/reflex-client.ts
new file mode 100644
index 0000000..dbe8e71
--- /dev/null
+++ b/packages/desktop/src/nebula/reflex-client.ts
@@ -0,0 +1,44 @@
+import { parseReflexResponse, reflexQuestions, type ReflexConfig, type ReflexRequest } from "../../../app/src/nebula/reflex"
+import type { AgentId } from "../../../app/src/nebula/agents"
+
+export function reflexTarget(config: ReflexConfig) {
+  if (config.provider === "cloudflare") return `https://api.cloudflare.com/client/v4/accounts/${config.accountId}/ai/run/@cf/cloudflare/${config.model}`
+  return config.endpoint
+}
+export function decodeReflexResponse(config: ReflexConfig, raw: unknown, available: readonly AgentId[]) {
+  const envelope = raw as { success?: unknown; result?: unknown }
+  const value = config.provider === "cloudflare" ? envelope?.success === true ? envelope.result : undefined : raw
+  const body = value as { model?: unknown; usage?: { input_tokens?: unknown } } | undefined
+  if (!body || body.model !== config.model) throw new Error("Modelo ou envelope inválido")
+  const tokens = body.usage?.input_tokens
+  return { ...parseReflexResponse(body, available, config.minConfidence), classifierModel: config.model,
+    ...(typeof tokens === "number" && Number.isSafeInteger(tokens) && tokens >= 0 && tokens <= 10000000 ? { inputTokens: tokens } : {}) }
+}
+export async function requestReflex(config: ReflexConfig, request: ReflexRequest, available: readonly AgentId[], token?: string) {
+  if (!available.length) throw new Error("Nenhum especialista disponível")
+  if (request.text.length > 4096) throw new Error("Pedido excede o limite de contexto")
+  const target = reflexTarget(config)
+  const local = ["localhost", "127.0.0.1", "[::1]"].includes(new URL(target).hostname)
+  if (!token && (config.provider === "cloudflare" || !local)) throw new Error("Token não configurado")
+  const response = await fetch(target, {
+    method: "POST", redirect: "error", signal: AbortSignal.timeout(config.timeoutMs),
+    headers: { "Content-Type": "application/json", ...(token ? { Authorization: `Bearer ${token}` } : {}) },
+    body: JSON.stringify({ model: config.model, state: { request: request.text, hasImages: request.hasImages }, questions: reflexQuestions(available) }),
+  })
+  if (!response.ok) { await response.body?.cancel(); throw new Error("Serviço de decisões indisponível") }
+  const reader = response.body?.getReader()
+  if (!reader) throw new Error("Resposta vazia")
+  const chunks: Uint8Array[] = []
+  let size = 0
+  try {
+    while (true) {
+      const part = await reader.read()
+      if (part.done) break
+      size += part.value.byteLength
+      if (size > 65536) throw new Error("Resposta excede o limite")
+      chunks.push(part.value)
+    }
+  } finally { await reader.cancel().catch(() => undefined) }
+  const raw = JSON.parse(Buffer.concat(chunks).toString("utf8"))
+  return decodeReflexResponse(config, raw, available)
+}
