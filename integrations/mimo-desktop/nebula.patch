+function DeleteRecentDialog(props: { session: Session; remove: () => Promise<void> }) {
+  const dialog = useDialog()
+  const [busy, setBusy] = createSignal(false)
+  const [error, setError] = createSignal("")
+  async function remove() {
+    if (busy()) return
+    setBusy(true)
+    setError("")
+    try {
+      await props.remove()
+      dialog.close()
+    } catch {
+      setError("Não foi possível excluir a conversa. Tente novamente.")
+    } finally { setBusy(false) }
+  }
+  return <Dialog title="Excluir conversa" fit>
+    <div class="nebula-delete-dialog">
+      <p>Excluir a conversa <strong>“{props.session.title}”</strong>?</p>
+      <p>As mensagens e as conversas dos agentes vinculados serão removidas permanentemente. Uma execução em andamento será interrompida. Os arquivos do projeto serão preservados.</p>
+      <Show when={error()}><p class="nebula-delete-error" role="alert">{error()}</p></Show>
+      <div class="nebula-delete-actions">
+        <Button type="button" variant="ghost" disabled={busy()} autofocus onClick={() => dialog.close()}>Cancelar</Button>
+        <Button type="button" variant="primary" disabled={busy()} onClick={() => void remove()}>{busy() ? "Excluindo…" : "Excluir conversa"}</Button>
+      </div>
+    </div>
+  </Dialog>
+}
