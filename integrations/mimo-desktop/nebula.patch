diff --git a/packages/app/src/components/nebula-reflex.tsx b/packages/app/src/components/nebula-reflex.tsx
new file mode 100644
index 0000000..e4e0c21
--- /dev/null
+++ b/packages/app/src/components/nebula-reflex.tsx
@@ -0,0 +1,61 @@
+import { createEffect, createSignal, onCleanup, Show } from "solid-js"
+import { Icon } from "@mimo-ai/ui/icon"
+import { Tooltip } from "@mimo-ai/ui/tooltip"
+import { usePlatform } from "@/context/platform"
+import { agents } from "@/nebula/agents"
+import { clarificationQuestions, type ReflexDecision } from "@/nebula/reflex"
+import "./nebula-reflex.css"
+
+const reflexHelp = "O Nebula Reflex ajuda a escolher o agente adequado para sua tarefa e aponta informações que faltam. Clique em “Orientar tarefa” para receber uma sugestão. Você decide se quer aplicá-la; a tarefa só começa quando você envia a mensagem."
+
+export function NebulaReflex(props: { text: string; hasImages: boolean; disabled: boolean }) {
+  const platform = usePlatform()
+  const [decision, setDecision] = createSignal<ReflexDecision>()
+  const [busy, setBusy] = createSignal(false)
+  const [error, setError] = createSignal("")
+  const [helpFocused, setHelpFocused] = createSignal(false)
+  let revision = 0
+  onCleanup(() => { revision += 1 })
+  createEffect(() => {
+    props.text; props.hasImages; platform.taskAgent?.()
+    revision += 1
+    setDecision(undefined); setError(""); setBusy(false)
+  })
+  async function orient() {
+    const current = ++revision
+    setBusy(true); setError(""); setDecision(undefined)
+    try {
+      const result = await platform.suggestReflex!(props.text, props.hasImages)
+      if (revision === current) setDecision(result)
+    } catch { if (revision === current) setError("Não foi possível orientar esta tarefa. Você pode continuar com sua escolha manual.") }
+    finally { if (revision === current) setBusy(false) }
+  }
+  async function feedback(result: ReflexDecision, action: "applied" | "dismissed") {
+    if (action === "applied" && result.agent && !result.locked) platform.selectTaskAgent?.(result.agent)
+    setDecision(undefined)
+    await platform.reflexFeedback?.(result.id, action).catch(() => setError("Não foi possível registrar seu retorno. Sua escolha de agente foi preservada."))
+  }
+  return <Show when={platform.reflexEnabled?.() && platform.suggestReflex}>
+    <div class="nebula-reflex">
+      <div class="nebula-reflex-heading">
+        <Tooltip placement="top-start" openDelay={200} forceOpen={helpFocused()} value={reflexHelp} contentClass="nebula-reflex-tooltip">
+          <button type="button" class="nebula-reflex-help" aria-label="O que é o Nebula Reflex?" aria-description={reflexHelp}
+            onFocus={() => setHelpFocused(true)} onBlur={() => setHelpFocused(false)}
+            onKeyDown={event => { if (event.key === "Escape") setHelpFocused(false) }}>
+            <strong>Nebula Reflex</strong><Icon name="help" size="small" />
+          </button>
+        </Tooltip>
+        <button type="button" disabled={busy() || props.disabled || !props.text.trim()} onClick={() => void orient()}>{busy() ? "Analisando…" : "Orientar tarefa"}</button>
+      </div>
+      <Show when={decision()}>{result => <div class="nebula-reflex-result" role="status">
+        <div class="nebula-reflex-heading"><strong>{result().agent ? agents[result().agent!].name : "Esclarecer objetivo"}</strong><small>{({ local: "Regras locais", cloudflare: "Clef", systemone: "SystemOne", explicit: "Escolha preservada", editor: "Ação do editor", disabled: "Desativado" })[result().source]}</small></div>
+        <p>{result().reason}</p>
+        <Show when={result().modelName}><p>Modelo configurado: {result().modelName}</p></Show>
+        <Show when={result().clarification !== "none"}><p class="nebula-reflex-question">{clarificationQuestions[result().clarification]}</p></Show>
+        <Show when={result().notice}><p>{result().notice}</p></Show>
+        <div class="nebula-reflex-actions"><Show when={result().agent && !result().locked}><button type="button" disabled={props.disabled} onClick={() => void feedback(result(), "applied")}>Usar este agente</button></Show><button type="button" onClick={() => void feedback(result(), "dismissed")}>Manter minha escolha</button></div>
+      </div>}</Show>
+      <Show when={error()}><p role="alert">{error()}</p></Show>
+    </div>
+  </Show>
+}
