@@ -0,0 +1,28 @@
+import { batch, createSignal } from "solid-js"
+import type { Mission } from "./missions"
+export const [activeMission, setActiveMission] = createSignal<Mission>()
+export const [pendingTaskDraft, setPendingTaskDraft] = createSignal<Mission>()
+export function prepareMission(mission: Mission) {
+  batch(() => {
+    setActiveMission(mission)
+    setPendingTaskDraft(mission.sessionID ? undefined : mission)
+  })
+}
+
+export const [draftRevision, setDraftRevision] = createSignal(0)
+export function refreshMission(mission: Mission) {
+  batch(() => {
+    if (activeMission()?.id === mission.id) setActiveMission(mission)
+    if (pendingTaskDraft()?.id === mission.id) setPendingTaskDraft(mission.sessionID ? undefined : mission)
+  })
+}
+export function forgetMission(id: string) {
+  batch(() => {
+    if (activeMission()?.id === id) setActiveMission(undefined)
+    if (pendingTaskDraft()?.id === id) {
+      setPendingTaskDraft(undefined)
+      setDraftRevision(value => value + 1)
+    }
+  })
+}
+export const resetTaskDraft = () => { setActiveMission(undefined); setPendingTaskDraft(undefined); setDraftRevision(value => value + 1) }
