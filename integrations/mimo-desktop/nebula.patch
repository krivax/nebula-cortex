diff --git a/packages/app/src/components/nebula-mission-changes.tsx b/packages/app/src/components/nebula-mission-changes.tsx
new file mode 100644
index 0000000..7f3f9db
--- /dev/null
+++ b/packages/app/src/components/nebula-mission-changes.tsx
@@ -0,0 +1,89 @@
+import { createEffect, createMemo, createResource, createSignal, For, Show } from "solid-js"
+import { Icon } from "@mimo-ai/ui/icon"
+import { normalize as normalizeSessionDiff } from "@mimo-ai/ui/session-diff"
+import { usePlatform } from "@/context/platform"
+import type { Mission } from "@/nebula/missions"
+import { changeLabels, missionPatchLines, type MissionChange } from "@/nebula/mission-changes"
+
+export function NebulaMissionChanges(props: { mission: Mission }) {
+  const platform = usePlatform()
+  const [expanded, setExpanded] = createSignal(false)
+  const [revision, setRevision] = createSignal(0)
+  const [editorError, setEditorError] = createSignal(false)
+  createEffect(() => { props.mission.id; setExpanded(false); setEditorError(false) })
+  const [changes] = createResource(
+    () => expanded() && platform.missionChanges ? [props.mission.id, revision()] as const : undefined,
+    ([id]) => platform.missionChanges!(id),
+  )
+  const current = () => changes()?.missionID === props.mission.id ? changes() : undefined
+  return <section class="nebula-mission-changes" aria-label="Revisão de alterações da missão">
+    <h3>Revisar alterações</h3>
+    <p>Compare as linhas registradas na conversa principal. Estas diferenças mostram o histórico da execução; o arquivo no disco pode ter recebido edições depois.</p>
+    <div class="nebula-mission-actions">
+      <button type="button" disabled={!props.mission.sessionID || !platform.missionChanges} aria-expanded={expanded()} onClick={() => setExpanded(value => !value)}>
+        <Icon name="code-lines" size="small" />{expanded() ? "Ocultar diferenças" : "Ver diferenças"}
+      </button>
+      <button type="button" disabled={!platform.openCodeEditor} onClick={async () => {
+        setEditorError(false)
+        await platform.openCodeEditor?.(props.mission.directory).catch(() => setEditorError(true))
+      }}><Icon name="code" size="small" />Abrir projeto no Editor Nebula</button>
+    </div>
+    <Show when={editorError()}><p role="alert">Não foi possível abrir o editor.</p></Show>
+    <Show when={expanded()}>
+      <div class="nebula-changes-toolbar">
+        <span>− linha removida · + linha adicionada</span>
+        <button type="button" disabled={changes.loading} onClick={() => setRevision(value => value + 1)}>Atualizar diferenças</button>
+      </div>
+      <Show when={changes.loading}><p role="status">Carregando diferenças…</p></Show>
+      <Show when={changes.error}><p role="alert">Não foi possível consultar as diferenças. A conversa pode ter sido excluída ou o motor pode estar indisponível. Tente atualizar.</p></Show>
+      <Show when={!changes.loading && !changes.error && current()}>{value => <>
+        <p role="status">{value().files.length} arquivo(s) com alterações registradas.</p>
+        <Show when={value().omitted}><p>Alguns arquivos não foram exibidos por limite de tamanho ou formato. Consulte a conversa para revisar o restante.</p></Show>
+        <For each={value().files}>{file => <ChangeFile change={file} />}</For>
+        <Show when={!value().files.length}><p>O motor ainda não registrou diferenças para esta conversa. Isso não garante que o projeto esteja sem alterações; confira também a conversa e o editor.</p></Show>
+      </>}</Show>
+    </Show>
+  </section>
+}
+
+function ChangeFile(props: { change: MissionChange }) {
+  const [opened, setOpened] = createSignal(false)
+  const displayPatch = createMemo(() => {
+    if (!opened()) return ""
+    if (props.change.format === "patch") return props.change.patch
+    if (props.change.format !== "contents" || props.change.truncated) return ""
+    try {
+      return normalizeSessionDiff({ file: props.change.file, before: props.change.before, after: props.change.after,
+        additions: props.change.additions, deletions: props.change.deletions, status: props.change.status }).patch
+    } catch { return "" }
+  })
+  const patch = createMemo(() => missionPatchLines(displayPatch()))
+  return <details class="nebula-change-file" onToggle={event => setOpened(event.currentTarget.open)}>
+    <summary>
+      <Icon name="chevron-down" size="small" />
+      <span class="nebula-change-name">{props.change.file}</span>
+      <span>{props.change.status ? changeLabels[props.change.status] : "Alteração registrada"}</span>
+      <span class="nebula-change-counts"><span>+{props.change.additions}</span><span>−{props.change.deletions}</span></span>
+    </summary>
+    <Show when={opened()}>
+      <Show when={props.change.truncated || patch().truncated}><p>Prévia parcial por limite de tamanho. Revise o conteúdo completo na conversa ou no editor.</p></Show>
+      <Show when={displayPatch()}>
+        <div class="nebula-change-scroll" tabIndex={0} role="region" aria-label={`Diferenças em ${props.change.file}`}>
+          <table class="nebula-change-patch">
+            <thead><tr><th scope="col">Antes</th><th scope="col">Depois</th><th scope="col">Alteração</th></tr></thead>
+            <tbody><For each={patch().lines}>{line => <tr data-kind={line.kind}>
+              <td>{line.before ?? ""}</td><td>{line.after ?? ""}</td><td><code>{line.text}</code></td>
+            </tr>}</For></tbody>
+          </table>
+        </div>
+      </Show>
+      <Show when={!displayPatch() && props.change.format === "contents" && (props.change.before || props.change.after)}>
+        <div class="nebula-change-contents">
+          <div><h4>Antes da alteração</h4><pre>{props.change.before || "Sem conteúdo anterior."}</pre></div>
+          <div><h4>Depois da alteração</h4><pre>{props.change.after || "Sem conteúdo posterior."}</pre></div>
+        </div>
+      </Show>
+      <Show when={!props.change.patch && !props.change.before && !props.change.after}><p>O motor não disponibilizou uma comparação textual para este arquivo. Abra o projeto no editor para conferir.</p></Show>
+    </Show>
+  </details>
+}
