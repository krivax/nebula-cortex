@@ -0,0 +1,36 @@
+import { app, nativeTheme } from "electron"
+import { mkdir, rename, writeFile } from "node:fs/promises"
+import { join } from "node:path"
+import { getStore } from "./store"
+
+export type Appearance = "system" | "light" | "dark"
+export function appearance(value: unknown): Appearance {
+  if (value !== "system" && value !== "light" && value !== "dark") throw new Error("Aparência inválida")
+  return value
+}
+export function getAppearance(): Appearance {
+  const value = getStore().get("nebula-appearance")
+  return value === "light" || value === "dark" ? value : "system"
+}
+export const appearancePath = () => join(app.getPath("userData"), "appearance.json")
+let pending = Promise.resolve()
+function publish() {
+  const value = JSON.stringify({ scheme: getAppearance(), mode: nativeTheme.shouldUseDarkColors ? "dark" : "light" })
+  pending = pending.catch(() => undefined).then(async () => {
+    await writeFile(appearancePath() + ".tmp", value, { mode: 0o600 })
+    await rename(appearancePath() + ".tmp", appearancePath())
+  })
+  return pending
+}
+export async function setAppearance(value: unknown) {
+  const scheme = appearance(value)
+  getStore().set("nebula-appearance", scheme)
+  nativeTheme.themeSource = scheme
+  await publish()
+}
+export async function initializeAppearance() {
+  await mkdir(app.getPath("userData"), { recursive: true })
+  nativeTheme.themeSource = getAppearance()
+  await publish()
+  nativeTheme.on("updated", () => { void publish().catch(() => console.warn("Não foi possível sincronizar a aparência do editor")) })
+}
