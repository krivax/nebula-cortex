+import { describe, expect, test } from "bun:test"
+import { createServer } from "node:http"
+import { createOpencodeClient } from "@mimo-ai/sdk/v2/client"
+import { deleteRecentSession } from "./history"
+
+async function fixture(abort: number | boolean, deletion: number | boolean) {
+  const requests: { method: string; pathname: string; directory: string | null }[] = []
+  const server = createServer((request, response) => {
+    const headers = { "Access-Control-Allow-Origin": "*", "Access-Control-Allow-Methods": "POST, DELETE, OPTIONS", "Access-Control-Allow-Headers": "Content-Type" }
+    if (request.method === "OPTIONS") { response.writeHead(204, headers); response.end(); return }
+    const url = new URL(request.url!, "http://example.com")
+    requests.push({ method: request.method!, pathname: url.pathname, directory: url.searchParams.get("directory") })
+    const result = url.pathname.endsWith("/abort") ? abort : deletion
+    response.writeHead(typeof result === "number" ? result : 200, { ...headers, "Content-Type": "application/json" })
+    response.end(JSON.stringify(typeof result === "number" ? { message: "Falha sintética" } : result))
+  })
+  await new Promise<void>(resolve => server.listen(0, "127.0.0.1", resolve))
+  const address = server.address()
+  if (!address || typeof address === "string") throw new Error("Servidor de teste não iniciou")
+  return { requests, stop: () => { server.closeAllConnections(); server.close() }, client: createOpencodeClient({ baseUrl: `http://127.0.0.1:${address.port}` }) }
+}
+const session = { id: "test-session", directory: "/tmp/example/projeto com espaço" }
+
+describe("exclusão do histórico", () => {
+  test("interrompe antes de excluir e usa a pasta da conversa nas duas chamadas", async () => {
+    const value = await fixture(true, true)
+    try {
+      await deleteRecentSession(value.client, session)
+      expect(value.requests).toEqual([
+        { method: "POST", pathname: "/session/test-session/abort", directory: session.directory },
+        { method: "DELETE", pathname: "/session/test-session", directory: session.directory },
+      ])
+    } finally { value.stop() }
+  })
+  test("não exclui se a interrupção falha", async () => {
+    const value = await fixture(500, true)
+    try {
+      await expect(deleteRecentSession(value.client, session)).rejects.toBeDefined()
+      expect(value.requests.map(item => item.method)).toEqual(["POST"])
+    } finally { value.stop() }
+  })
+  test("propaga falha de exclusão para preservar o item na interface", async () => {
+    const value = await fixture(true, 500)
+    try { await expect(deleteRecentSession(value.client, session)).rejects.toBeDefined() }
+    finally { value.stop() }
+  })
+  test("exige confirmação de sucesso do servidor", async () => {
+    const value = await fixture(true, false)
+    try { await expect(deleteRecentSession(value.client, session)).rejects.toThrow("Não foi possível excluir a conversa.") }
+    finally { value.stop() }
+  })
+})
diff --git a/packages/app/src/nebula/history.ts b/packages/app/src/nebula/history.ts
new file mode 100644
index 0000000..3649bf7
--- /dev/null
+++ b/packages/app/src/nebula/history.ts
@@ -0,0 +1,9 @@
+import type { OpencodeClient, Session } from "@mimo-ai/sdk/v2/client"
+
+export async function deleteRecentSession(client: OpencodeClient, session: Pick<Session, "id" | "directory">) {
+  const parameters = { directory: session.directory, sessionID: session.id }
+  const stopped = await client.session.abort(parameters, { throwOnError: true })
+  if (stopped.data !== true) throw new Error("Não foi possível interromper a conversa.")
+  const deleted = await client.session.delete(parameters, { throwOnError: true })
+  if (deleted.data !== true) throw new Error("Não foi possível excluir a conversa.")
+}
