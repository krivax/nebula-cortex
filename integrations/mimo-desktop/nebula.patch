+import { describe, expect, test } from "bun:test"
+import { mkdtemp, mkdir, writeFile, symlink, rm } from "node:fs/promises"
+import { tmpdir } from "node:os"
+import { join } from "node:path"
+import { configSchema, defaultConfig, resolveAgentModel, engineConfig } from "./config"
+import { specialistEngine } from "../../../app/src/nebula/agents"
+import { inspectProject, projectContext } from "../main/nebula-project"
+
+describe("professional agent configuration", () => {
+  test("existing model settings gain agent defaults without losing assignments", () => {
+    const { operator: _operator, ...legacy } = defaultConfig()
+    const migrated = configSchema.parse(legacy)
+    expect(migrated.assignments).toEqual(legacy.assignments)
+    expect(migrated.operator.questioning).toBe("adaptive")
+    expect(resolveAgentModel(migrated, "configuration").model.id).toBe(legacy.assignments.code!)
+  })
+  test("a specialist model override survives validation and does not change other agents", () => {
+    const config = defaultConfig()
+    config.models.push({
+      id: "specialist",
+      name: "Specialist",
+      providerId: config.providers[0].id,
+      model: "test/specialist",
+      capabilities: ["code"],
+      context: 32768,
+      output: 4096,
+    })
+    config.operator.models.configuration = "specialist"
+    const parsed = configSchema.parse(config)
+    expect(resolveAgentModel(parsed, "configuration").model.model).toBe("test/specialist")
+    expect(resolveAgentModel(parsed, "development").model.id).toBe(config.assignments.code!)
+    config.operator.models.browser = "specialist"
+    expect(configSchema.safeParse(config).success).toBe(false)
+  })
+  test("settings without a coordinator migrate and only configured specialists can be delegated", () => {
+    const previous = JSON.parse(JSON.stringify(defaultConfig()))
+    delete previous.operator.models.coordinator
+    const config = configSchema.parse(previous)
+    expect(config.operator.models.coordinator).toBeNull()
+    const engine = engineConfig(config)
+    expect(engine.agent.nebula_coordinator.mode).toBe("primary")
+    expect(engine.agent[specialistEngine("configuration")].mode).toBe("subagent")
+    expect(engine.agent[specialistEngine("configuration")].permission.actor).toBe("deny")
+    expect(engine.agent[specialistEngine("vision")]).toBeUndefined()
+    expect(engine.agent.nebula_coordinator.prompt).not.toContain(specialistEngine("vision"))
+    expect(engine.agent.nebula_coordinator.permission.actor).toEqual(expect.objectContaining({ "*": "deny", [specialistEngine("configuration")]: "ask" }))
+  })
+  test("delegated agents retain their configured model and tools", () => {
+    const config = defaultConfig()
+    config.models.push({ id: "specialist", name: "Specialist", providerId: config.providers[0].id, model: "test/specialist", capabilities: ["code"], context: 32768, output: 4096 })
+    config.operator.models.configuration = "specialist"
+    const engine = engineConfig(config)
+    expect(engine.agent[specialistEngine("configuration")].model).toBe(`${config.providers[0].id}/test/specialist`)
+    expect(engine.agent[specialistEngine("writing")].permission["*"]).toBe("deny")
+    expect(engine.agent.nebula_coordinator.prompt).toContain("sem herdar a conversa")
+  })
+  test("role contexts and interviewing modes are shipped to the engine", () => {
+    const config = defaultConfig()
+    config.operator.questioning = "deep"
+    const serialized = JSON.stringify(engineConfig(config))
+    expect(serialized).toContain("nebula_development")
+    expect(serialized).toContain("uma questão de cada vez")
+    expect(serialized).toContain("enfraqueça autenticação")
+    expect(serialized).toContain("Controle visual genérico")
+  })
+})
+
+test("project inspection detects a mixed stack without reading secrets or following symlinks", async () => {
+  const root = await mkdtemp(join(tmpdir(), "nebula-project-test-"))
+  try {
+    await mkdir(join(root, "src"))
+    await mkdir(join(root, "node_modules"))
+    await mkdir(join(root, "target"))
+    await writeFile(join(root, "package.json"), JSON.stringify({ dependencies: { react: "test" } }))
+    await writeFile(join(root, "Cargo.toml"), "[package]\nname = 'example'\n")
+    await writeFile(join(root, "src", "example.tsx"), "export const example = 1")
+    await writeFile(join(root, "src", "example.rs"), "fn main() {}")
+    await writeFile(join(root, "node_modules", "ignored.py"), "")
+    await writeFile(join(root, "target", "ignored.go"), "")
+    await writeFile(join(root, ".env"), "SECRET=synthetic-secret")
+    await symlink(join(root, "node_modules"), join(root, "linked"))
+    const profile = await inspectProject(root)
+    expect(profile.languages.map((language) => language.name).sort()).toEqual(["Rust", "TypeScript"])
+    expect(profile.frameworks).toEqual(["React"])
+    expect(profile.manifests.sort()).toEqual(["Cargo.toml", "package.json"])
+    expect(projectContext(profile)).not.toContain("synthetic-secret")
+  } finally {
+    await rm(root, { recursive: true, force: true })
+  }
+})
