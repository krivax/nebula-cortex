+      </For>
+      <Show when={!connections.loading && !connections.error && !Object.keys(connections() ?? {}).length}>
+        <div class="nebula-panel-empty">
+          <Icon name="mcp" />
+          <h3>Nenhuma conexão MCP</h3>
+          <p>Cadastre um servidor remoto nas configurações de IA. O instalador de plugins continua em desenvolvimento.</p>
+        </div>
+      </Show>
+    </section>
+  )
+}
+
+function Artifacts(props: { directory: string; openEditor: () => Promise<void> }) {
+  const sdk = useGlobalSDK()
+  const [path, setPath] = createSignal("")
+  const [selected, setSelected] = createSignal("")
+  const [revision, setRevision] = createSignal(0)
+  const [files] = createResource(
+    () => [props.directory, path(), revision()] as const,
+    async ([directory, path]) => (await sdk.client.file.list({ directory, path })).data ?? [],
+  )
+  const [content] = createResource(
+    () => (selected() ? ([props.directory, selected()] as const) : undefined),
+    async ([directory, path]) => (await sdk.client.file.read({ directory, path })).data,
+  )
+  return (
+    <section class="nebula-workspace-panel nebula-artifacts-panel">
+      <div class="nebula-panel-heading">
+        <div>
+          <h1>Artefatos do projeto</h1>
+          <p>Arquivos reais da pasta selecionada.</p>
+        </div>
+        <button
+          onClick={() => {
+            setRevision((r) => r + 1)
+            setSelected("")
+          }}
+        >
+          Atualizar
+        </button>
+        <button onClick={() => void props.openEditor()}>Abrir no editor ↗</button>
+      </div>
+      <div class="nebula-artifact-path">
+        <button
+          onClick={() => {
+            setPath("")
+            setSelected("")
+          }}
+        >
+          Projeto
+        </button>
+        <Show when={path()}>
+          <span>/ {path()}</span>
+          <button
+            onClick={() => {
+              setPath(path().split("/").slice(0, -1).join("/"))
+              setSelected("")
+            }}
+          >
+            Voltar
+          </button>
+        </Show>
+      </div>
+      <Show when={files.error}>
+        <p role="alert">Não foi possível listar os arquivos.</p>
+      </Show>
+      <div class="nebula-artifact-grid">
+        <For each={files()?.filter((file) => !file.ignored)}>
+          {(file) => (
+            <button
+              class="nebula-artifact-card"
+              aria-pressed={selected() === file.path}
+              onClick={() => {
+                if (file.type === "directory") {
+                  setPath(file.path)
+                  setSelected("")
+                  return
+                }
+                setSelected(file.path)
+              }}
+            >
+              <Icon name={file.type === "directory" ? "folder" : "code-lines"} />
+              <strong>{file.name}</strong>
+              <small>{file.type === "directory" ? "Pasta" : "Arquivo"}</small>
+            </button>
+          )}
+        </For>
+      </div>
+      <Show when={!files.loading && !files.error && !files()?.filter((file) => !file.ignored).length}>
+        <div class="nebula-panel-empty">
+          <Icon name="archive" />
+          <h3>Nenhum arquivo nesta pasta</h3>
+          <p>Os arquivos criados durante as tarefas aparecerão aqui.</p>
+        </div>
+      </Show>
+      <Show when={selected()}>
+        <div class="nebula-artifact-preview">
+          <header>
+            <strong>{selected()}</strong>
+            <button aria-label="Fechar prévia" onClick={() => setSelected("")}>
+              ×
+            </button>
+          </header>
+          <Show when={content.error}>
+            <p role="alert">Não foi possível abrir o arquivo.</p>
+          </Show>
+          <Show when={content()}>
+            {(file) => (
+              <Show
+                when={file().type === "text" && file().encoding !== "base64"}
+                fallback={<p>Abra este arquivo no editor para visualizar seu conteúdo.</p>}
+              >
+                <pre>{file().content.slice(0, 100000)}</pre>
+              </Show>
+            )}
+          </Show>
+        </div>
+      </Show>
+    </section>
+  )
+}
+
+function Authorizations(props: { directory: string; resume: (id: string) => void }) {
+  const sdk = useGlobalSDK()
+  const [requests, actions] = createResource(
+    () => props.directory,
+    async (directory) => (await sdk.client.permission.list({ directory })).data ?? [],
+  )
+  const unsubscribe = sdk.event.listen((event) => {
+    if (event.details.type.startsWith("permission.")) void actions.refetch()
+  })
+  onCleanup(unsubscribe)
+  return (
+    <section class="nebula-workspace-panel">
+      <h1>Autorizações</h1>
+      <p>Acompanhe os pedidos de acesso das suas tarefas.</p>
+      <Show when={requests.error}>
+        <p role="alert">Não foi possível carregar os pedidos.</p>
+      </Show>
+      <For each={requests()}>
+        {(request) => (
+          <article class="nebula-feature-card">
+            <Icon name="shield" />
+            <div>
+              <h2>{request.permission}</h2>
+              <p>{request.patterns.join(", ")}</p>
+            </div>
+            <button onClick={() => props.resume(request.sessionID)}>Voltar à tarefa</button>
+          </article>
+        )}
+      </For>
+      <Show when={!requests.loading && !requests.error && !requests()?.length}>
+        <div class="nebula-panel-empty">
+          <Icon name="check" />
+          <h3>Nenhum pedido pendente</h3>
+          <p>Quando uma tarefa precisar de autorização, o pedido aparecerá na conversa.</p>
+        </div>
+      </Show>
+    </section>
+  )
+}
+
+export function NebulaHome() {
+  const platform = usePlatform()
+  const navigate = useNavigate()
+  const [workspace] = createResource(() => platform.taskWorkspace!())
+  createEffect(() => {
+    const path = workspace()
+    if (path) navigate(`/${base64Encode(path)}/session`, { replace: true })
+  })
+  return (
+    <div class="nebula-home-loading">
+      <Show when={workspace.error} fallback={<p>Preparando seu workspace…</p>}>
+        <p role="alert">Não foi possível abrir o workspace.</p>
+        <button onClick={() => void platform.restart()}>Reiniciar</button>
+      </Show>
+    </div>
+  )
+}
