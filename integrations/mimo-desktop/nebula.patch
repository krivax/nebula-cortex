+  const directory = () => decode64(params.dir) || workspace() || ""
+  const directories = createMemo(() => [
+    ...new Set(
+      [workspace(), directory(), ...layout.projects.list().map((p) => p.worktree)].filter(
+        (p): p is string => !!p && p !== "/",
+      ),
+    ),
+  ])
+  const [sessions, sessionActions] = createResource(
+    () => [directories().join("\0"), revision()] as const,
