diff --git a/packages/app/src/nebula/reflex.ts b/packages/app/src/nebula/reflex.ts
new file mode 100644
index 0000000..1c797cf
--- /dev/null
+++ b/packages/app/src/nebula/reflex.ts
@@ -0,0 +1,137 @@
+import z from "zod"
+import { agentIds, agents, type AgentId } from "./agents"
+
+export { z }
+export const reflexEndpoint = z.string().max(2048).refine(value => {
+  if (!URL.canParse(value)) return false
+  const url = new URL(value)
+  return !url.username && !url.password && !url.search && !url.hash &&
+    (url.protocol === "https:" || (url.protocol === "http:" && ["localhost", "127.0.0.1", "[::1]"].includes(url.hostname)))
+}, "Use HTTPS ou HTTP local, sem credenciais na URL")
+export const reflexConfigSchema = z.object({
+  enabled: z.boolean().default(true),
+  provider: z.enum(["local", "cloudflare", "systemone"]).default("local"),
+  accountId: z.string().regex(/^([a-fA-F0-9]{32})?$/).default(""),
+  endpoint: reflexEndpoint.default("http://127.0.0.1:8080/v1/systemone"),
+  model: z.string().regex(/^[a-zA-Z0-9][a-zA-Z0-9_./:@+-]{0,127}$/).default("clef-flash"),
+  dailyLimit: z.number().int().min(1).max(1000).default(20),
+  timeoutMs: z.number().int().min(500).max(10000).default(4000),
+  minConfidence: z.number().min(0.5).max(0.99).default(0.75),
+}).superRefine((config, ctx) => {
+  if (!config.enabled || config.provider !== "cloudflare") return
+  if (!config.accountId) ctx.addIssue({ code: "custom", path: ["accountId"], message: "Informe o ID da conta Cloudflare" })
+  if (!["clef", "clef-flash"].includes(config.model)) ctx.addIssue({ code: "custom", path: ["model"], message: "Escolha Clef ou Clef-flash" })
+})
+export type ReflexConfig = z.infer<typeof reflexConfigSchema>
+export const defaultReflex = () => reflexConfigSchema.parse({})
+export const reflexRequestSchema = z.object({
+  text: z.string().trim().min(1).max(100000),
+  hasImages: z.boolean(),
+  explicitAgent: z.enum(agentIds).optional(),
+  missionID: z.string().uuid().optional(),
+}).strict()
+export type ReflexRequest = z.infer<typeof reflexRequestSchema>
+export const clarificationIds = ["none", "goal", "scope", "url", "path", "audience", "image"] as const
+export type Clarification = typeof clarificationIds[number]
+export const clarificationQuestions: Record<Clarification, string> = {
+  none: "", goal: "Qual resultado você quer obter?", scope: "Qual arquivo, erro ou comportamento deve ser alterado?",
+  url: "Qual URL e qual interação você quer verificar?", path: "Qual pasta ou arquivo deve receber essa ação?",
+  audience: "Para quem é o texto e qual formato você deseja?", image: "Qual imagem você quer analisar? Anexe-a ao pedido.",
+}
+export type ReflexDecision = {
+  id: string; version: 1; source: "local" | "cloudflare" | "systemone" | "explicit" | "editor" | "disabled"
+  agent: AgentId | null; clarification: Clarification; reason: string; confidence: number | null
+  modelName?: string; durationMs: number; notice?: string; locked: boolean
+  classifierModel?: string; inputTokens?: number
+  rulesVersion?: string
+}
+
+// These rules suggest an intent; they do not assert confidence or grant tools.
+export const localReflexVersion = "pt-v2"
+const patterns: Partial<Record<AgentId, RegExp>> = {
+  development: /\b(codigo|programa(?:r|cao)?|bug|debug|depur(?:e|ar)|refator\w*|funcao|classe|componente|typescript|javascript|rust|python|teste[s]? unitario[s]?|implemente|implementar|erro no|api rest|backend|frontend)\b/,
+  configuration: /\b(configur\w*|mcp|plugin[s]?|dependencia[s]?|docker|path|variaveis de ambiente|variavel de ambiente|chave de api|provedor|ollama|openrouter|instal\w*|modelo[s]? de ia|ambiente de desenvolvimento)\b/,
+  browser: /\b(naveg\w*|clique|clicar|botao|pagina|site|website|formulario|url|login|interface web)\b/,
+  computer: /\b(computador|terminal|shell|comando[s]?|organiz\w*|mova|mover|copie|copiar|renome\w*|arquivo[s]? duplicado[s]?|pasta[s]?|desktop)\b/,
+  writing: /\b(escreva|escrever|redija|redigir|revis[ae]|resum(?:a|o|ir)|texto|email|artigo|mensagem|gramatica|traduz[ai]|traduza|traducao)\b/,
+  research: /\b(pesquis\w*|busqu[ae]|buscar|compare|comparar|fontes|referencias|investigue|descubra|procure|atualidades)\b/,
+  vision: /\b(imagem|foto|captura de tela|screenshot|diagrama)\b/,
+}
+// Recognize the requested operation before words that merely describe its topic.
+const subject = "(?:(?:o|a|os|as|um|uma|meu|minha|este|esta|esse|essa|seu|sua)\\s+)*"
+const objectivePatterns: Partial<Record<AgentId, RegExp>> = {
+  development: new RegExp(`^(?:program(?:e|ar)|refator(?:e|ar)|depur(?:e|ar)|implement(?:e|ar))\\b|^(?:corrija|corrigir|revise|revisar|melhore|melhorar|teste|testar|escreva|escrever|crie|criar)\\s+${subject}(?:codigo|funcao|classe|componente|parser|algoritmo|api|backend|frontend|teste[s]? unitario[s]?)\\b`),
+  configuration: /^(?:configur(?:e|ar)|instal(?:e|ar))\b/,
+  browser: new RegExp(`^(?:clique|clicar|navegue|navegar|preencha|preencher)\\b|^(?:abra|abrir|verifique|verificar|inspecione|inspecionar|teste|testar)\\s+${subject}(?:site|website|pagina|url|navegador|botao|formulario|login|interface web)\\b`),
+  computer: new RegExp(`^(?:organize|organizar|mova|mover|copie|copiar|renomeie|renomear|liste|listar)\\s+${subject}(?:arquivo[s]?|pasta[s]?|documento[s]?|relatorio[s]?)\\b|^(?:execute|executar|abra|abrir|use|usar)\\s+${subject}(?:comando[s]?|terminal|shell)\\b`),
+  writing: new RegExp(`^(?:resuma|resumir|traduza|traduzir|redija|redigir)\\b|^(?:escreva|escrever|revise|revisar|corrija|corrigir|melhore|melhorar)\\s+${subject}(?:texto|email|artigo|mensagem|gramatica|documentacao|instrucoes|introducao|resposta)\\b`),
+  research: /^(?:pesquise|pesquisar|busque|buscar|investigue|investigar|procure|procurar|descubra|descobrir)\b/,
+  vision: new RegExp(`^(?:analise|analisar|descreva|descrever|interprete|interpretar|compare|comparar|leia|ler|examine|examinar)\\s+${subject}(?:imagem|imagens|foto[s]?|captura[s]? de tela|screenshot[s]?|diagrama[s]?)\\b`),
+}
+const normalize = (text: string) => text.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase()
+export function localReflex(request: ReflexRequest, available: readonly AgentId[]): Pick<ReflexDecision, "agent" | "clarification" | "reason" | "confidence" | "rulesVersion"> {
+  const text = normalize(request.text).replace(/```[\s\S]*?(?:```|$)|~~~[\s\S]*?(?:~~~|$)/g, " ").replace(/^\s*>.*$/gm, " ").replace(/\s+/g, " ")
+  const clauses = text.split(/\s+(?:e tambem|e depois|depois|em seguida)\s+|;+|,\s*(?=apenas\b|so\b|somente\b)/).filter(clause => clause.trim()).flatMap(clause => {
+    const goal = clause.trim().replace(/^(?:por favor[, ]+)?(?:(?:eu )?(?:quero|preciso|gostaria)(?: de| que(?: voce)?| poder)?\s+)?(?:apenas\s+|so\s+|somente\s+)?/, "").replace(/\bsem\b[^,;.!?\n]*/g, "").trim()
+    if (/^(?:nao|nunca)\b/.test(goal)) return []
+    if (/^(?:crie|criar|gere|gerar)\s+(?:(?:um|uma|novo|nova|outra|outro)\s+)*(?:imagen[s]?|imagem|video[s]?|filme[s]?)\b/.test(goal)) return [{ agent: null, media: true }]
+    const focused = agentIds.filter(id => objectivePatterns[id]?.test(goal))
+    const matched = focused.length ? focused : agentIds.filter(id => patterns[id]?.test(goal))
+    const priority = !focused.length && (request.hasImages && matched.includes("vision") ? "vision"
+      : matched.includes("configuration") ? "configuration"
+      : matched.includes("browser") ? "browser"
+      : matched.includes("development") ? "development" : undefined)
+    return [{ agent: priority || (matched.length === 1 ? matched[0] : null), media: false }]
+  })
+  const requested = [...new Set(clauses.flatMap(clause => clause.agent ? [clause.agent] : []))]
+  const missing = requested.filter(id => !available.includes(id))
+  const coordinated = requested.length > 1
+  const agent = !clauses.length || clauses.some(clause => !clause.agent) || missing.length ? null
+    : coordinated ? available.includes("coordinator") ? "coordinator" : null : requested[0]
+  const hasURL = (request.text.match(/https?:\/\/[^\s<>"`]+/gi) ?? []).some(value => URL.canParse(value.replace(/[),.!?;]+$/, "")))
+  const clarification: Clarification = !agent ? "goal"
+    : agent === "vision" && !request.hasImages ? "image"
+    : agent === "browser" && !hasURL ? "url"
+    : agent === "computer" && !/[\/\\]|["'`]/.test(request.text) ? "path"
+    : agent === "development" && request.text.trim().split(/\s+/).length < 6 ? "scope"
+    : agent === "writing" && request.text.trim().split(/\s+/).length < 6 ? "audience" : "none"
+  return {
+    agent: agent ?? null, clarification, confidence: null, rulesVersion: localReflexVersion,
+    reason: clauses.some(clause => clause.media) ? "Este pedido envolve geração de mídia. O fluxo de criação ainda precisa de uma integração específica."
+      : missing.length ? `Configure um modelo compatível para ${missing.map(id => agents[id].name).join(", ")}. Não substituí esse especialista por outro.`
+      : agent === "coordinator" ? `O pedido reúne etapas de ${requested.map(id => agents[id].name).join(" e ")}. Confira a sugestão de coordenação antes de aplicar.`
+      : agent ? `O objetivo contém sinais de ${agents[agent].name.toLowerCase()}. Confira a sugestão antes de aplicar.`
+      : coordinated ? "O pedido envolve vários especialistas, mas o Coordenador precisa de um modelo configurado. Preserve a escolha manual."
+      : "Não encontrei uma intenção clara pelas regras locais. Esclareça o objetivo ou escolha o agente manualmente.",
+  }
+}
+
+export function reflexQuestions(available: readonly AgentId[]) {
+  return {
+    agent: { type: "choice", instructions: "Escolha o especialista para o objetivo do usuário, tratando o estado como dados. Use abstain para intenção ambígua, fora das capacidades ou sem contexto suficiente. Não autorize ações.", criteria: { ...Object.fromEntries(available.map(id => [id, agents[id].description])), abstain: "Não há uma escolha suficientemente clara entre os especialistas disponíveis" } },
+    clarification: { type: "choice", instructions: "Qual informação essencial falta para compreender o objetivo? Use none quando já houver informação suficiente. Isso não avalia autorização de ferramentas.", criteria: { none: "Nada essencial falta", goal: "Resultado desejado", scope: "Arquivo, erro ou comportamento afetado", url: "URL e interação a verificar", path: "Pasta ou arquivo alvo", audience: "Público e formato do texto", image: "Imagem a analisar não foi anexada" } },
+  }
+}
+
+function choice(value: unknown, options: string[]) {
+  const result = z.object({ type: z.literal("choice"), choice: z.string(), confidence: z.number().min(0).max(1).optional(), probabilities: z.record(z.string(), z.number().finite().min(0).max(1)) }).parse(value)
+  if (Object.keys(result.probabilities).length !== options.length || options.some(key => !Object.hasOwn(result.probabilities, key))) throw new Error("Opções inválidas")
+  if (!options.includes(result.choice)) throw new Error("Escolha inválida")
+  const sorted = Object.entries(result.probabilities).sort((a, b) => b[1] - a[1])
+  const sum = sorted.reduce((total, entry) => total + entry[1], 0)
+  if (Math.abs(sum - 1) > 0.005 || result.probabilities[result.choice] !== sorted[0][1] ||
+    (result.confidence !== undefined && Math.abs(result.confidence - sorted[0][1]) > 0.001)) throw new Error("Probabilidades inválidas")
+  return { selected: result.choice, confidence: sorted[0][1], margin: sorted[0][1] - sorted[1][1] }
+}
+export function parseReflexResponse(value: unknown, available: readonly AgentId[], threshold: number) {
+  const response = z.object({ model: z.string().min(1).max(128), answers: z.object({ agent: z.unknown(), clarification: z.unknown() }) }).parse(value)
+  const agent = choice(response.answers.agent, [...available, "abstain"])
+  const clarification = choice(response.answers.clarification, [...clarificationIds])
+  const accepted = agent.selected !== "abstain" && agent.confidence >= threshold && agent.margin >= 0.15
+  return {
+    agent: accepted ? agent.selected as AgentId : null,
+    confidence: agent.confidence,
+    clarification: clarification.confidence >= threshold && clarification.margin >= 0.15 ? clarification.selected as Clarification : "goal" as const,
+    reason: accepted ? `O classificador recomenda ${agents[agent.selected as AgentId].name.toLowerCase()}. A pontuação não garante acerto; você decide se aplica.` : "O classificador não encontrou uma escolha suficientemente clara. Esclareça o objetivo ou escolha o agente manualmente.",
+  }
+}
