+import { describe, expect, test } from "bun:test"
+import { missionChangesPayload, missionPatchLines } from "./mission-changes"
+
+describe("diferenças das missões", () => {
+  test("preserva patch, estado e contagens fornecidos pelo motor", () => {
+    const patch = "--- a/example.ts\n+++ b/example.ts\n@@ -1 +1 @@\n-const example = 1\n+const example = 2\n"
+    const result = missionChangesPayload("test-mission", [{ file: "example.ts", patch, additions: 1, deletions: 1, status: "modified" }])
+    expect(result.files[0]).toMatchObject({ file: "example.ts", patch, status: "modified", format: "patch", truncated: false })
+    expect(result.omitted).toBe(0)
+  })
+  test("aceita o formato anterior com conteúdo antes e depois", () => {
+    const result = missionChangesPayload("test-mission", [{ file: "example.ts", before: "const example = 1", after: "const example = 2", additions: 1, deletions: 1 }])
+    expect(result.files[0]).toMatchObject({ format: "contents", before: "const example = 1", after: "const example = 2", truncated: false })
+  })
+  test("não inventa conteúdo quando o motor retorna apenas metadados", () => {
+    const result = missionChangesPayload("test-mission", [{ file: "example.bin", additions: 0, deletions: 0 }])
+    expect(result.files[0]).toMatchObject({ format: "unavailable", patch: "", before: "", after: "" })
+  })
+  test("limita texto por arquivo e por resposta, indicando prévias parciais", () => {
+    const result = missionChangesPayload("test-mission", Array.from({ length: 6 }, (_, i) => ({ file: `example-${i}.ts`, patch: "x".repeat(100000), additions: 1, deletions: 1 })))
+    expect(result.files.every(item => item.patch.length <= 64 * 1024 && item.truncated)).toBe(true)
+    expect(result.files.reduce((sum, item) => sum + item.patch.length, 0)).toBe(256 * 1024)
+  })
+  test("limita quantidade de arquivos e informa dados inválidos ou omitidos", () => {
+    const items = Array.from({ length: 105 }, (_, i) => ({ file: `example-${i}.ts`, patch: "", additions: 0, deletions: 0 }))
+    expect(missionChangesPayload("test-mission", items)).toMatchObject({ omitted: 5 })
+    expect(missionChangesPayload("test-mission", [null, { file: "example.ts", additions: -1, deletions: 0 }]).omitted).toBe(2)
+    expect(() => missionChangesPayload("test-mission", {})).toThrow("Diferenças inválidas")
+  })
+  test("metadados e cabeçalhos não recebem números de linhas de código", () => {
+    const result = missionPatchLines("diff --git a/example.ts b/example.ts\n--- a/example.ts\n+++ b/example.ts\n@@ -2,2 +2,2 @@\n const example = 1\n-const previous = 1\n+const next = 2\n")
+    expect(result.lines.slice(0, 4).every(line => line.kind === "header" && !line.before && !line.after)).toBe(true)
+    expect(result.lines.slice(4)).toEqual([
+      { kind: "context", before: 2, after: 2, text: " const example = 1" },
+      { kind: "removed", before: 3, text: "-const previous = 1" },
+      { kind: "added", after: 3, text: "+const next = 2" },
+    ])
+  })
+  test("reinicia números em cada trecho e não conta nota de ausência de quebra de linha", () => {
+    const result = missionPatchLines("@@ -1 +1 @@\n-old\n\\ No newline at end of file\n+new\n@@ -10,0 +11,1 @@\n+added\n")
+    expect(result.lines.filter(line => line.kind === "added").map(line => line.after)).toEqual([1, 11])
+    expect(result.lines.find(line => line.kind === "note")).toEqual({ kind: "note", text: "\\ No newline at end of file" })
+  })
+  test("prefixos semelhantes a cabeçalhos são código dentro de um trecho", () => {
+    const result = missionPatchLines("@@ -1,1 +1,1 @@\n---example\n+++example\n")
+    expect(result.lines[1]).toEqual({ kind: "removed", before: 1, text: "---example" })
+    expect(result.lines[2]).toEqual({ kind: "added", after: 1, text: "+++example" })
+  })
+  test("prévia de patch limita linhas sem renderizar o restante", () => {
+    const result = missionPatchLines("@@ -0,0 +1,2000 @@\n" + "+example\n".repeat(2000))
+    expect(result.lines.length).toBe(1000)
+    expect(result.truncated).toBe(true)
+  })
+})
diff --git a/packages/app/src/nebula/mission-changes.ts b/packages/app/src/nebula/mission-changes.ts
new file mode 100644
index 0000000..f48b428
--- /dev/null
+++ b/packages/app/src/nebula/mission-changes.ts
@@ -0,0 +1,60 @@
+import { z } from "zod"
+
+const changeSchema = z.object({
+  file: z.string().min(1).max(4096), additions: z.number().int().nonnegative(), deletions: z.number().int().nonnegative(),
+  status: z.enum(["added", "deleted", "modified"]).optional(), patch: z.string().optional(),
+  before: z.string().optional(), after: z.string().optional(),
+})
+export type MissionChange = {
+  file: string; additions: number; deletions: number; status?: "added" | "deleted" | "modified";
+  format: "patch" | "contents" | "unavailable"; patch: string; before: string; after: string; truncated: boolean;
+}
+export type MissionChanges = { missionID: string; files: MissionChange[]; omitted: number }
+export const changeLabels = { added: "Adicionado", deleted: "Removido", modified: "Modificado" }
+
+export function missionChangesPayload(missionID: string, value: unknown): MissionChanges {
+  if (!Array.isArray(value)) throw new Error("Diferenças inválidas do motor")
+  let remaining = 256 * 1024
+  const files = value.slice(0, 100).flatMap(item => {
+    const result = changeSchema.safeParse(item)
+    if (!result.success) return []
+    const change = result.data
+    const limit = Math.min(64 * 1024, remaining)
+    const format = typeof change.patch === "string" ? "patch" : typeof change.before === "string" && typeof change.after === "string" ? "contents" : "unavailable"
+    const patch = format === "patch" ? change.patch!.slice(0, limit) : ""
+    const before = format === "contents" ? change.before!.slice(0, Math.floor(limit / 2)) : ""
+    const after = format === "contents" ? change.after!.slice(0, Math.floor(limit / 2)) : ""
+    remaining -= patch.length + before.length + after.length
+    return [{ file: change.file, additions: change.additions, deletions: change.deletions, status: change.status, format,
+      patch, before, after, truncated: format === "patch" ? patch.length < change.patch!.length : format === "contents" && (before.length < change.before!.length || after.length < change.after!.length) } satisfies MissionChange]
+  })
+  return { missionID, files, omitted: value.length - files.length }
+}
+
+export type PatchLine = { kind: "header" | "context" | "added" | "removed" | "note"; before?: number; after?: number; text: string }
+export function missionPatchLines(patch: string): { lines: PatchLine[]; truncated: boolean } {
+  const source = patch.split(/\r?\n/)
+  if (source.at(-1) === "") source.pop()
+  let before = 0
+  let after = 0
+  let oldRemaining = 0
+  let newRemaining = 0
+  const lines = source.slice(0, 1000).map((text): PatchLine => {
+    const hunk = /^@@ -(\d+)(?:,(\d+))? \+(\d+)(?:,(\d+))? @@/.exec(text)
+    if (hunk) {
+      before = Number(hunk[1]); after = Number(hunk[3])
+      oldRemaining = Number(hunk[2] ?? 1); newRemaining = Number(hunk[4] ?? 1)
+      return { kind: "header", text }
+    }
+    if (text.startsWith("\\")) return { kind: "note", text }
+    if (oldRemaining <= 0 && newRemaining <= 0) return { kind: "header", text }
+    if (text.startsWith("+") && newRemaining > 0) { newRemaining -= 1; return { kind: "added", after: after++, text } }
+    if (text.startsWith("-") && oldRemaining > 0) { oldRemaining -= 1; return { kind: "removed", before: before++, text } }
+    if (text.startsWith(" ") && oldRemaining > 0 && newRemaining > 0) {
+      oldRemaining -= 1; newRemaining -= 1
+      return { kind: "context", before: before++, after: after++, text }
+    }
+    return { kind: "header", text }
+  })
+  return { lines, truncated: source.length > lines.length }
+}
