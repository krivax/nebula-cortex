+        </DropdownMenu.Portal>
+      </DropdownMenu>
+      <Tooltip placement="top" value={`Configurar modelos de IA · ${model()}`}>
+        <button type="button" class="nebula-prompt-icon" aria-label={`Configurar modelo da conversa: ${model()}`} onClick={() => void platform.openAISettings?.()}>
+          <Icon name="models" />
+        </button>
+      </Tooltip>
+      <Tooltip placement="top" value="Acesso com autorização. As ferramentas pedem aprovação antes de agir.">
