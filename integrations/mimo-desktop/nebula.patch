+})
+test("seleciona executáveis nativos sem invocar shell", () => {
+  expect(nodeExecutable("win32")).toBe("node/node.exe")
+  expect(engineExecutable("win32")).toBe("bin/mimo.exe")
+  expect(nodeExecutable("linux")).toBe("node/bin/node")
+  expect(engineExecutable("darwin")).toBe("bin/mimo")
