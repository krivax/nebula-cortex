@@ -0,0 +1,84 @@
+import { createResource, createSignal, For, onCleanup, Show } from "solid-js"
+import { createStore, reconcile } from "solid-js/store"
+import { usePlatform } from "@/context/platform"
+import { missionStates, type Mission, type MissionDetail } from "@/nebula/missions"
+import { NebulaMissionChanges } from "@/components/nebula-mission-changes"
+import { MissionDialog } from "@/components/nebula-mission-dialog"
+import { Icon } from "@mimo-ai/ui/icon"
+import { Tooltip } from "@mimo-ai/ui/tooltip"
+import { useDialog } from "@mimo-ai/ui/context/dialog"
+import { refreshMission, forgetMission } from "@/nebula/tasks"
+
+export function Missions(props: { directory: string; open: (mission: Mission) => void }) {
+  const platform = usePlatform()
+  const dialog = useDialog()
+  const [revision, setRevision] = createSignal(0)
+  const [items] = createResource(revision, () => platform.missions!())
+  const [selected, setSelected] = createSignal<string>()
+  const [goal, setGoal] = createSignal("")
+  const [error, setError] = createSignal("")
+  const [creating, setCreating] = createSignal(false)
+  const [tick, setTick] = createSignal(0)
+  const [view, setView] = createStore<{ detail?: MissionDetail }>({})
+  const [detail] = createResource(() => selected() ? [selected()!, tick()] as const : undefined, async ([id, version]) => {
+    const value = await platform.missionDetail!(id)
+    if (selected() === id && tick() === version) setView("detail", reconcile(value))
+    return view.detail
+  })
+  const timer = setInterval(() => {
+    if (view.detail?.mission.id === selected() && (view.detail?.state === "running" || view.detail?.state === "waiting")) setTick(value => value + 1)
+  }, 2500)
+  onCleanup(() => clearInterval(timer))
+  async function create() {
+    setCreating(true); setError("")
+    try { const mission = await platform.createMission!(props.directory, goal()); setGoal(""); props.open(mission) }
+    catch { setError("Não foi possível criar a missão. Confira o objetivo e o projeto.") }
+    finally { setCreating(false) }
+  }
+  async function complete() {
+    const id = selected()
+    if (!id) return
+    setError("")
+    try { await platform.completeMission!(id); setTick(value => value + 1); setRevision(value => value + 1) }
+    catch { setError("Aguarde o fim da execução e revise os resultados antes de concluir.") }
+  }
+  function manage(mission: Mission, action: "edit" | "remove") {
+    dialog.show(() => <MissionDialog mission={mission} action={action} save={async objective => {
+      if (action === "edit") {
+        const updated = await platform.editMission!(mission.id, objective)
+        refreshMission(updated)
+        if (selected() === updated.id && view.detail?.mission.id === updated.id) setView("detail", "mission", reconcile(updated))
+      } else {
+        await platform.removeMission!(mission.id)
+        forgetMission(mission.id)
+        if (selected() === mission.id) { setSelected(undefined); setView("detail", undefined) }
+      }
+      setRevision(value => value + 1); setTick(value => value + 1)
+    }} />)
+  }
+  return <section class="nebula-workspace-panel nebula-missions">
+    <h1>Missões Nebula</h1><p>Objetivos, plano e evidências ligados às conversas do projeto. Preparar uma missão não inicia chamadas de IA.</p>
+    <form class="nebula-mission-create" onSubmit={event => { event.preventDefault(); void create() }}><label>Objetivo da missão<textarea required maxLength={8000} value={goal()} onInput={event => setGoal(event.currentTarget.value)} placeholder="Exemplo: corrigir o fluxo de login e verificar seus testes" /></label><button disabled={creating() || !goal().trim()} type="submit">{creating() ? "Preparando…" : "Preparar missão"}</button></form>
+    <Show when={error() || items.error || detail.error}><p role="alert">{error() || "Não foi possível consultar as missões. Tente atualizar."}</p></Show>
+    <button onClick={() => { setRevision(value => value + 1); setTick(value => value + 1) }}>Atualizar</button>
+    <div class="nebula-mission-body">
+    <div class="nebula-mission-list" role="region" aria-label="Lista de missões"><For each={(items() ?? []).filter(item => item.directory === props.directory)}>{mission => <div class="nebula-mission-row">
+      <button class="nebula-mission-card" aria-pressed={selected() === mission.id} onClick={() => setSelected(mission.id)}><strong>{mission.objective}</strong><small>{mission.completed ? "Concluída por você" : mission.sessionID ? "Conversa vinculada" : "Pronta para enviar"} · {new Date(mission.updated).toLocaleString("pt-BR")}</small><Show when={mission.file}><small>{mission.file} · linhas {mission.range?.startLine}–{mission.range?.endLine}</small></Show></button>
+      <div class="nebula-mission-row-actions"><Tooltip value="Editar objetivo"><button type="button" aria-label={`Editar missão: ${mission.objective}`} onClick={() => manage(mission, "edit")}><Icon name="pencil-line" size="small" /></button></Tooltip><Tooltip value="Remover missão"><button type="button" aria-label={`Remover missão: ${mission.objective}`} onClick={() => manage(mission, "remove")}><Icon name="trash" size="small" /></button></Tooltip></div>
+    </div>}</For></div>
+    <Show when={!items.loading && !(items() ?? []).some(item => item.directory === props.directory)}><p>Este projeto ainda não tem missões. Crie um objetivo acima ou envie um trecho pelo Editor Nebula.</p></Show>
+    <Show when={detail()?.mission.id === selected() ? detail() : undefined}>{value => <article class="nebula-mission-detail">
+      <h2>{value().mission.objective}</h2><p role="status"><strong>{missionStates[value().state]}</strong> · {value().mission.model || "Modelo será escolhido ao enviar"}</p>
+      <div class="nebula-mission-actions"><button onClick={() => props.open(value().mission)}>{value().mission.sessionID ? "Retomar conversa e revisar" : "Revisar solicitação e enviar"}</button><button disabled={value().state !== "review"} onClick={() => void complete()}>Confirmar conclusão após revisão</button></div>
+      <For each={value().warnings}>{warning => <p>{warning}</p>}</For>
+      <Show when={value().permissions || value().questions}><p>{value().permissions} autorização(ões) e {value().questions} pergunta(s) pendentes. Abra a conversa para responder.</p></Show>
+      <h3>Plano registrado pelo agente</h3><Show when={value().todos.length} fallback={<p>O agente ainda não registrou etapas.</p>}><ol><For each={value().todos}>{todo => <li>{({ pending: "Pendente", in_progress: "Em andamento", completed: "Concluída", cancelled: "Cancelada" } as Record<string, string>)[todo.status] || todo.status}: {todo.content}</li>}</For></ol></Show>
+      <h3>Agentes observados</h3><p>{value().agents.join(" · ") || "Nenhum agente iniciou a execução."}</p>
+      <h3>Ferramentas e evidências</h3><p>O estado concluído de uma ferramenta indica que a chamada terminou. Confira a saída para avaliar se a validação passou.</p><For each={value().evidence}>{item => <details><summary>{item.title} · {item.tool} · {item.status}</summary><pre>{item.output || "Sem saída registrada nesta etapa."}</pre></details>}</For>
+      <h3>Arquivos alterados na conversa</h3><p>{value().files.join(" · ") || "Nenhuma alteração registrada."}</p>
+      <NebulaMissionChanges mission={value().mission} />
+      <Show when={value().answer}><details><summary>Última resposta do agente</summary><pre>{value().answer}</pre></details></Show>
+    </article>}</Show>
+    </div>
+  </section>
+}
