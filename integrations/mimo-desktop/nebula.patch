+import { app } from "electron"
+import { randomUUID } from "node:crypto"
+import { mkdir, readFile, writeFile, chmod, rename } from "node:fs/promises"
+import { join } from "node:path"
+import { agents, agentIds, type AgentId } from "../../../app/src/nebula/agents"
+import { z, reflexRequestSchema, localReflex, type ReflexDecision } from "../../../app/src/nebula/reflex"
+import { resolveAgentModel } from "../nebula/config"
+import { requestReflex } from "../nebula/reflex-client"
+import { readSettings, reflexCredential } from "./nebula-settings"
+import { getMission } from "./nebula-missions"
+
+const entrySchema = z.object({ id: z.string().uuid(), at: z.number(), source: z.string().max(20), agent: z.enum(agentIds).nullable(), confidence: z.number().nullable(), durationMs: z.number(), classifierModel: z.string().max(128).optional(), inputTokens: z.number().int().nonnegative().optional(), rulesVersion: z.string().max(32).optional(), feedback: z.enum(["applied", "dismissed"]).optional() })
+const ledgerSchema = z.object({ version: z.literal(1), day: z.string().regex(/^\d{4}-\d{2}-\d{2}$/), attempts: z.number().int().nonnegative(), entries: z.array(entrySchema).max(200) })
+const location = () => join(app.getPath("userData"), "reflex.json")
+let pending = Promise.resolve()
+async function ledger() {
+  const raw = await readFile(location(), "utf8").catch(error => { if (error.code === "ENOENT") return undefined; throw new Error("Registro de decisões indisponível") })
+  const value = raw ? ledgerSchema.parse(JSON.parse(raw)) : { version: 1 as const, day: "", attempts: 0, entries: [] }
+  const today = new Date().toISOString().slice(0, 10)
+  return { ...value, day: today, attempts: value.day === today ? value.attempts : 0 }
+}
+async function persist(value: z.infer<typeof ledgerSchema>) {
+  await mkdir(app.getPath("userData"), { recursive: true })
+  await writeFile(location() + ".tmp", JSON.stringify(ledgerSchema.parse(value)), { mode: 0o600 })
+  await chmod(location() + ".tmp", 0o600)
+  await rename(location() + ".tmp", location())
+}
+function serial<T>(run: () => Promise<T>) {
+  const result = pending.catch(() => undefined).then(run)
+  pending = result.then(() => undefined, () => undefined)
+  return result
+}
+export function suggestReflex(input: unknown) {
+  const request = reflexRequestSchema.parse(input)
+  return serial(async () => {
+    const start = performance.now()
+    const saved = await readSettings()
+    const config = saved.config.reflex
+    const available = agentIds.filter(id => { try { resolveAgentModel(saved.config, id); return true } catch { return false } })
+    const mission = request.missionID ? await getMission(request.missionID) : undefined
+    const explicit = mission && mission.action !== "general" ? "development" : request.explicitAgent
+    const base = { id: randomUUID(), version: 1 as const, durationMs: 0, locked: !!explicit }
+    let result: ReflexDecision = { ...base, source: "local", ...localReflex(request, available) }
+    const usage = await ledger()
+    if (!config.enabled) result = { ...base, source: "disabled", agent: null, clarification: "none", confidence: null, reason: "Nebula Reflex está desativado." }
+    else if (explicit) result = { ...base, source: mission && mission.action !== "general" ? "editor" : "explicit", agent: explicit, clarification: "none", confidence: null, reason: `Sua escolha de ${agents[explicit].name.toLowerCase()} foi preservada. Nenhum classificador foi chamado.` }
+    else if (config.provider !== "local" && available.length) {
+      if (request.text.length > 4096) result.notice = "Pedido acima de 4.096 caracteres: somente regras locais foram usadas."
+      else if (usage.attempts >= config.dailyLimit) result.notice = "Limite diário de chamadas atingido (UTC). Somente regras locais foram usadas."
+      else {
+        // Reserve before sending: timeouts and invalid responses can still incur cost.
+        usage.attempts += 1
+        await persist(usage)
+        try {
+          result = { ...base, source: config.provider, ...await requestReflex(config, request, available, reflexCredential(saved)) }
+        } catch {
+          result.notice = "O serviço de decisões falhou ou retornou dados inválidos. Somente regras locais foram usadas; nenhum outro provedor foi chamado."
+        }
+      }
+    }
+    if (result.agent === "vision" && !request.hasImages) result.clarification = "image"
+    if (result.agent) {
+      try { result.modelName = resolveAgentModel(saved.config, result.agent).model.name }
+      catch { result.notice = "Configure um modelo compatível para usar esse agente." }
+    }
+    result.durationMs = Math.round(performance.now() - start)
+    usage.entries = [...usage.entries, { id: result.id, at: Date.now(), source: result.source, agent: result.agent, confidence: result.confidence, durationMs: result.durationMs, classifierModel: result.classifierModel, inputTokens: result.inputTokens, rulesVersion: result.rulesVersion }].slice(-200)
+    await persist(usage)
+    return result
+  })
+}
+export function reflexFeedback(id: unknown, action: unknown) {
+  const key = z.string().uuid().parse(id)
+  const feedback = z.enum(["applied", "dismissed"]).parse(action)
+  return serial(async () => {
+    const value = await ledger()
+    const entry = value.entries.find(item => item.id === key)
+    if (!entry) throw new Error("Decisão não encontrada")
+    entry.feedback = feedback
+    await persist(value)
+  })
+}
