+import { app } from "electron"
+import { spawn, type ChildProcess } from "node:child_process"
+import { randomBytes } from "node:crypto"
+import { mkdir } from "node:fs/promises"
+import { join, resolve } from "node:path"
+import { engineConfig } from "../nebula/config"
+import { credential, mcpCredential, readSettings } from "./nebula-settings"
+import { startOperator } from "./nebula-operator"
+import { engineExecutable } from "../nebula/platform"
+
+export const runtimeRoot = () => app.isPackaged ? join(process.resourcesPath, "nebula") : process.env.NEBULA_RUNTIME_ROOT || resolve(app.getAppPath(), "../../..")
+export const editorRuntime = () => app.isPackaged ? join(runtimeRoot(), "editor") : join(runtimeRoot(), ".editor-runtime", `${process.platform}-${process.arch}`, "bundle")
+export function stopProcess(child?: ChildProcess) {
+  if (!child?.pid) return
+  if (process.platform === "win32") {
+    const killer = spawn("taskkill.exe", ["/PID", String(child.pid), "/T", "/F"], { windowsHide: true, stdio: "ignore" })
+    killer.once("error", () => { try { child.kill("SIGKILL") } catch {} })
+    return
+  }
+  try { process.kill(-child.pid, "SIGKILL") } catch {}
+  child.kill("SIGKILL")
+}
+let child: ChildProcess | undefined
+const password = randomBytes(32).toString("hex")
+let port = 0
+let url = ""
+export const serverConnection = () => ({ url, username: "mimocode", password })
+export async function startServer() {
+  const saved = await readSettings()
+  const data = join(app.getPath("userData"), "engine")
+  await mkdir(join(data, "home"), { recursive: true })
+  await mkdir(join(data, "temp"), { recursive: true })
+  const env: NodeJS.ProcessEnv = {
+    PATH: process.env.PATH || "/usr/bin:/bin:/usr/sbin:/sbin",
+    HOME: join(data, "home"), USERPROFILE: join(data, "home"), MIMOCODE_HOME: join(data, "home"),
+    TMPDIR: join(data, "temp"), TEMP: join(data, "temp"), TMP: join(data, "temp"),
+    XDG_DATA_HOME: join(data, "data"), XDG_CONFIG_HOME: join(data, "config"), XDG_CACHE_HOME: join(data, "cache"), XDG_STATE_HOME: join(data, "state"),
+    MIMOCODE_CONFIG_CONTENT: JSON.stringify(engineConfig(saved.config, await startOperator())),
+    MIMOCODE_SERVER_PASSWORD: password,
+  }
+  if (process.platform === "win32") for (const name of ["SystemRoot", "SYSTEMROOT", "WINDIR", "COMSPEC", "PATHEXT"]) if (process.env[name]) env[name] = process.env[name]
+  for (const name of ["PROJECT_CONFIG", "AGENTS_SKILLS", "CLAUDE_CODE", "CLAUDE_CODE_COMMANDS", "PROVIDER_ENV", "DEFAULT_PLUGINS", "AUTOUPDATE", "MODELS_FETCH", "OFFICIAL_SKILLS", "LSP_DOWNLOAD", "BUILTIN_SKILLS", "COMPOSE_SKILLS", "SLASH_SKILLS", "EMBEDDED_WEB_UI"]) env[`MIMOCODE_DISABLE_${name}`] = "true"
+  for (const p of saved.config.providers) env[`NEBULA_TOKEN_${p.id}`] = credential(saved, p) ?? "not-configured"
+  for (const server of saved.config.externalMCP) {
+    if (!server.enabled || server.authentication !== "bearer") continue
+    const token = mcpCredential(saved, server)
+    if (!token) throw new Error(`Cadastre um token para o MCP ${server.name}`)
+    env[`NEBULA_MCP_TOKEN_${server.id}`] = `Bearer ${token}`
+  }
+  const bin = app.isPackaged ? join(runtimeRoot(), "mimo", engineExecutable()) : join(runtimeRoot(), ".mimo-runtime", `${process.platform}-${process.arch}`, engineExecutable())
+  child = spawn(bin, ["serve", "--hostname", "127.0.0.1", "--port", String(port), "--cors", "oc://renderer", "--log-level", "ERROR"], { cwd: join(data, "home"), env, detached: process.platform !== "win32", stdio: ["ignore", "pipe", "ignore"] })
+  const current = child
+  url = await new Promise<string>((resolve, reject) => {
+    const timeout = setTimeout(() => { stopProcess(current); reject(new Error("O motor Nebula não iniciou")) }, 30000)
+    const fail = () => { clearTimeout(timeout); reject(new Error("O motor Nebula não iniciou")) }
+    current.once("error", fail)
+    current.once("exit", fail)
+    let buffer = ""
+    current.stdout!.on("data", chunk => {
+      buffer = (buffer + chunk.toString()).slice(-8192)
+      const match = buffer.match(/mimocode server listening on (http:\/\/127\.0\.0\.1:\d+)/)
+      if (!match) return
+      clearTimeout(timeout); resolve(match[1])
+    })
+  })
+  port = Number(new URL(url).port)
+  return serverConnection()
+}
+export async function stopServer() {
+  const current = child; child = undefined
+  stopProcess(current)
+  if (!current || current.exitCode !== null || current.signalCode !== null) return
+  await new Promise<void>(resolve => {
+    const timeout = setTimeout(resolve, 5000)
+    current.once("close", () => { clearTimeout(timeout); resolve() })
+  })
+}
+export async function serverRequest(path: string, directory?: string) {
+  const headers = { authorization: `Basic ${Buffer.from(`mimocode:${password}`).toString("base64")}`, ...(directory ? { "x-mimocode-directory": encodeURIComponent(directory) } : {}) }
+  const response = await fetch(url + path, { headers, signal: AbortSignal.timeout(5000) })
+  if (!response.ok) throw new Error("O motor está indisponível")
+  return response.json()
+}
diff --git a/packages/desktop/src/main/nebula-settings.ts b/packages/desktop/src/main/nebula-settings.ts
new file mode 100644
index 0000000..5aab5ab
--- /dev/null
+++ b/packages/desktop/src/main/nebula-settings.ts
@@ -0,0 +1,83 @@
+import { app, safeStorage } from "electron"
+import { createHash } from "node:crypto"
+import { chmod, mkdir, readFile, rename, writeFile } from "node:fs/promises"
+import { join } from "node:path"
+import { configSchema, defaultConfig, type ModelConfig, type PublicConfig } from "../nebula/config"
+import { reflexTarget } from "../nebula/reflex-client"
+
+type Vault = Record<string, string>
+const account = (id: string, url: string) => createHash("sha256").update(`${id}\n${url}`).digest("hex")
+const mcpAccount = (id: string, url: string) => account(`mcp/${id}`, url)
+const reflexAccount = (config: ModelConfig) => "reflex:" + account(config.reflex.model, reflexTarget(config.reflex))
+const location = () => join(app.getPath("userData"), "models.json")
+export async function readSettings(): Promise<{ config: ModelConfig; vault: Vault }> {
+  const source = await readFile(location(), "utf8").catch(error => {
+    if (error.code === "ENOENT") return undefined
+    throw new Error("Não foi possível ler as configurações")
+  })
+  if (!source) return { config: defaultConfig(), vault: {} }
+  const saved = JSON.parse(source)
+  return { config: configSchema.parse(saved.config), vault: saved.vault ?? {} }
+}
+export async function publicSettings(): Promise<PublicConfig> {
+  const saved = await readSettings()
+  return { ...saved.config, reflexKey: !!saved.vault[reflexAccount(saved.config)], keys: Object.fromEntries(saved.config.providers.map(p => [p.id, !!saved.vault[account(p.id, p.baseUrl)]])), mcpKeys: Object.fromEntries(saved.config.externalMCP.map(server => [server.id, !!saved.vault[mcpAccount(server.id, server.url)]])) }
+}
+export async function saveSettings(value: unknown, keys: Record<string, string>, forget: string[], mcpKeys: Record<string, string> = {}, forgetMCP: string[] = [], reflexToken = "", forgetReflex = false) {
+  const config = configSchema.parse(value)
+  if (!keys || typeof keys !== "object" || Array.isArray(keys) || !Array.isArray(forget) || !mcpKeys || typeof mcpKeys !== "object" || Array.isArray(mcpKeys) || !Array.isArray(forgetMCP)) throw new Error("Credenciais inválidas")
+  const saved = await readSettings()
+  const vault: Vault = {}
+  if (typeof reflexToken !== "string" || reflexToken.length > 16384 || /[\r\n\u0000]/.test(reflexToken) || typeof forgetReflex !== "boolean") throw new Error("Token de decisões inválido")
+  const decisionKey = reflexAccount(config)
+  for (const [key, token] of Object.entries(saved.vault).filter(([key]) => key.startsWith("reflex:")).slice(-32)) {
+    if (!forgetReflex || key !== decisionKey) vault[key] = token
+  }
+  if (reflexToken) {
+    if (!safeStorage.isEncryptionAvailable() || (process.platform === "linux" && safeStorage.getSelectedStorageBackend() === "basic_text")) throw new Error("O armazenamento seguro do sistema não está disponível")
+    vault[decisionKey] = safeStorage.encryptString(reflexToken).toString("base64")
+  }
+  if (config.reflex.enabled && config.reflex.provider !== "local" && !vault[decisionKey] &&
+    (config.reflex.provider === "cloudflare" || !["localhost", "127.0.0.1", "[::1]"].includes(new URL(reflexTarget(config.reflex)).hostname))) throw new Error("Cadastre o token de decisões ou escolha Regras locais")
+  for (const provider of config.providers) {
+    const key = account(provider.id, provider.baseUrl)
+    const token = keys[provider.id]
+    if (token && (typeof token !== "string" || token.length > 16384 || /[\r\n]/.test(token))) throw new Error("Chave inválida")
+    if (token) {
+      if (!safeStorage.isEncryptionAvailable() || (process.platform === "linux" && safeStorage.getSelectedStorageBackend() === "basic_text")) throw new Error("O armazenamento seguro do sistema não está disponível")
+      vault[key] = safeStorage.encryptString(token).toString("base64")
+      continue
+    }
+    if (!forget.includes(provider.id) && saved.vault[key]) vault[key] = saved.vault[key]
+  }
+  for (const server of config.externalMCP) {
+    const key = mcpAccount(server.id, server.url)
+    const token = mcpKeys[server.id]
+    if (token && (typeof token !== "string" || token.length > 16384 || /[\r\n]/.test(token))) throw new Error("Token MCP inválido")
+    if (token) {
+      if (!safeStorage.isEncryptionAvailable() || (process.platform === "linux" && safeStorage.getSelectedStorageBackend() === "basic_text")) throw new Error("O armazenamento seguro do sistema não está disponível")
+      vault[key] = safeStorage.encryptString(token).toString("base64")
+    } else if (!forgetMCP.includes(server.id) && saved.vault[key]) vault[key] = saved.vault[key]
+    if (server.enabled && server.authentication === "bearer" && !vault[key]) throw new Error(`Cadastre um token para o MCP ${server.name} ou desative a conexão`)
+  }
+  await mkdir(app.getPath("userData"), { recursive: true })
+  await writeFile(location() + ".tmp", JSON.stringify({ config, vault }), { mode: 0o600 })
+  await chmod(location() + ".tmp", 0o600)
+  await rename(location() + ".tmp", location())
+}
+export function credential(saved: Awaited<ReturnType<typeof readSettings>>, provider: ModelConfig["providers"][number]) {
+  const value = saved.vault[account(provider.id, provider.baseUrl)]
+  if (value) return safeStorage.decryptString(Buffer.from(value, "base64"))
+  if (provider.kind === "ollama" && ["localhost", "127.0.0.1", "[::1]"].includes(new URL(provider.baseUrl).hostname)) return "ollama"
+  return undefined
+}
+
+export function mcpCredential(saved: Awaited<ReturnType<typeof readSettings>>, server: ModelConfig["externalMCP"][number]) {
+  const value = saved.vault[mcpAccount(server.id, server.url)]
+  return value ? safeStorage.decryptString(Buffer.from(value, "base64")) : undefined
+}
+
+export function reflexCredential(saved: Awaited<ReturnType<typeof readSettings>>) {
+  const value = saved.vault[reflexAccount(saved.config)]
+  return value ? safeStorage.decryptString(Buffer.from(value, "base64")) : undefined
+}
