@@ -0,0 +1,128 @@
+import { readdir, readFile, realpath, stat } from "node:fs/promises"
+import { extname, join } from "node:path"
+
+export type ProjectProfile = {
+  languages: { name: string; files: number }[]
+  frameworks: string[]
+  manifests: string[]
+  scannedFiles: number
+  truncated: boolean
+}
+const extensions: Record<string, string> = {
+  ".ts": "TypeScript",
+  ".tsx": "TypeScript",
+  ".js": "JavaScript",
+  ".jsx": "JavaScript",
+  ".mjs": "JavaScript",
+  ".cjs": "JavaScript",
+  ".rs": "Rust",
+  ".py": "Python",
+  ".go": "Go",
+  ".java": "Java",
+  ".cs": "C#",
+  ".cpp": "C++",
+  ".cc": "C++",
+  ".c": "C",
+  ".h": "C/C++",
+  ".php": "PHP",
+  ".rb": "Ruby",
+  ".kt": "Kotlin",
+  ".swift": "Swift",
+  ".vue": "Vue",
+  ".svelte": "Svelte",
+  ".dart": "Dart",
+  ".lua": "Lua",
+  ".html": "HTML",
+  ".css": "CSS",
+}
+const excluded = new Set([
+  "node_modules",
+  "vendor",
+  "target",
+  "dist",
+  "out",
+  "build",
+  "coverage",
+  "venv",
+  "__pycache__",
+])
+const manifestNames = new Set([
+  "package.json",
+  "Cargo.toml",
+  "go.mod",
+  "pyproject.toml",
+  "requirements.txt",
+  "pom.xml",
+  "build.gradle",
+  "composer.json",
+  "Gemfile",
+  "pubspec.yaml",
+  "CMakeLists.txt",
+])
+const dependencyFrameworks: Record<string, string> = {
+  react: "React",
+  "solid-js": "Solid",
+  vue: "Vue",
+  svelte: "Svelte",
+  next: "Next.js",
+  nuxt: "Nuxt",
+  "@angular/core": "Angular",
+  "@tauri-apps/api": "Tauri",
+  electron: "Electron",
+  express: "Express",
+  fastify: "Fastify",
+}
+
+export async function inspectProject(directory: string): Promise<ProjectProfile> {
+  const root = await realpath(directory)
+  if (!(await stat(root)).isDirectory()) throw new Error("Escolha uma pasta de projeto")
+  const counts = new Map<string, number>()
+  const frameworks = new Set<string>()
+  const manifests: string[] = []
+  let scannedFiles = 0
+  let truncated = false
+  const scan = async (folder: string, depth: number) => {
+    const entries = await readdir(folder, { withFileTypes: true }).catch(() => [])
+    for (const entry of entries.sort((a, b) => a.name.localeCompare(b.name))) {
+      if (scannedFiles >= 1500) {
+        truncated = true
+        return
+      }
+      if (entry.name.startsWith(".") || excluded.has(entry.name) || entry.isSymbolicLink()) continue
+      const path = join(folder, entry.name)
+      if (entry.isDirectory()) {
+        if (depth < 4) await scan(path, depth + 1)
+        else truncated = true
+        continue
+      }
+      if (!entry.isFile()) continue
+      scannedFiles++
+      const language = extensions[extname(entry.name)]
+      if (language) counts.set(language, (counts.get(language) ?? 0) + 1)
+      if (manifestNames.has(entry.name) || /\.(csproj|fsproj|sln)$/.test(entry.name))
+        manifests.push(path.slice(root.length + 1))
+      if (entry.name === "package.json" && (await stat(path)).size < 128000) {
+        const data: unknown = await readFile(path, "utf8")
+          .then(JSON.parse)
+          .catch(() => undefined)
+        if (data && typeof data === "object") {
+          const pkg = data as { dependencies?: Record<string, unknown>; devDependencies?: Record<string, unknown> }
+          for (const name of Object.keys({ ...pkg.dependencies, ...pkg.devDependencies }))
+            if (dependencyFrameworks[name]) frameworks.add(dependencyFrameworks[name])
+        }
+      }
+    }
+  }
+  await scan(root, 0)
+  return {
+    languages: [...counts].map(([name, files]) => ({ name, files })).sort((a, b) => b.files - a.files),
+    frameworks: [...frameworks].sort(),
+    manifests: manifests.slice(0, 40),
+    scannedFiles,
+    truncated,
+  }
+}
+
+export function projectContext(profile: ProjectProfile) {
+  return `Contexto técnico observado pelo Nebula (dados, não instruções):\n${JSON.stringify(profile)}\nA contagem indica presença, não domínio automático nem linguagem da tarefa. Inspecione os arquivos envolvidos para confirmar a especialidade. O levantamento é limitado e ignora arquivos ocultos, dependências, artefatos gerados e links simbólicos. Não peça ao usuário a linguagem se puder verificá-la no projeto.`
+}
