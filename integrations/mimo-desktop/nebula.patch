+        <Tooltip placement="top" value={`Escolher agente · ${agents[agent()].name}`}>
+          <DropdownMenu.Trigger type="button" class="nebula-prompt-icon nebula-agent-trigger" aria-label={`Agente da conversa: ${agents[agent()].name}`}>
+            <Icon name={agentIcons[agent()]} /><Icon name="chevron-down" size="small" />
+          </DropdownMenu.Trigger>
+        </Tooltip>
+        <DropdownMenu.Portal>
+          <DropdownMenu.Content class="nebula-purpose-menu" aria-label="Escolher agente">
+            <DropdownMenu.Group>
+            <DropdownMenu.GroupLabel>Agente para esta tarefa</DropdownMenu.GroupLabel>
+            <DropdownMenu.RadioGroup value={agent()} onChange={value => platform.selectTaskAgent?.(value as AgentId)}>
+              <For each={agentIds}>{id => <DropdownMenu.RadioItem value={id} class="nebula-agent-option" closeOnSelect>
+                <Icon name={agentIcons[id]} />
+                <div class="nebula-agent-option-copy">
+                  <DropdownMenu.ItemLabel>{agents[id].name}</DropdownMenu.ItemLabel>
+                  <DropdownMenu.ItemDescription>{agents[id].description}</DropdownMenu.ItemDescription>
+                </div>
+                <DropdownMenu.ItemIndicator><Icon name="check" /></DropdownMenu.ItemIndicator>
+              </DropdownMenu.RadioItem>}</For>
+            </DropdownMenu.RadioGroup>
