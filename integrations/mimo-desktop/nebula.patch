@@ -0,0 +1,126 @@
+import z from "zod"
+import { agentIds, agents, agentPrompt, questioningModes, type AgentId, specialistIds, specialistEngine } from "./agents"
+import { defaultReflex, reflexConfigSchema } from "./reflex"
+
+export const purposes = ["code", "text", "research", "image", "video", "vision", "design", "music"] as const
+export const labels: Record<Purpose, string> = { code: "Código", text: "Textos", research: "Pesquisas", image: "Criar imagens", video: "Criar vídeos", vision: "Analisar imagens", design: "Design e layouts", music: "Músicas" }
+export const providers = {
+  xiaomi: { name: "Xiaomi MiMo", url: "https://api.xiaomimimo.com/v1" },
+  openrouter: { name: "OpenRouter", url: "https://openrouter.ai/api/v1" },
+  huggingface: { name: "Hugging Face", url: "https://router.huggingface.co/v1" },
+  ollama: { name: "Ollama", url: "http://127.0.0.1:11434/v1" },
+  minimax: { name: "MiniMax", url: "https://api.minimax.io/v1" },
+  compatible: { name: "OpenAI compatível", url: "https://api.openai.com/v1" },
+} as const
+export const activePurposes = purposes.filter(purpose => purpose !== "design" && purpose !== "music")
+export type Purpose = typeof purposes[number]
+const id = z.string().regex(/^[a-z][a-z0-9_-]{0,63}$/)
+const name = z.string().trim().min(1).max(160)
+const mcpAgents = z.array(z.enum(agentIds)).max(agentIds.length).refine(list => new Set(list).size === list.length, "Agentes duplicados")
+const command = z.array(z.string().max(8192).refine(value => !/[\u0000\r\n]/.test(value), "Argumento inválido")).min(1).max(65).refine(value => /^(\/|[a-zA-Z]:[\\/])/.test(value[0]), "Informe o caminho absoluto do programa")
+const endpoint = z.string().max(2048).refine(value => {
+  const url = URL.canParse(value) ? new URL(value) : undefined
+  return !!url && !url.username && !url.password && !url.search && !url.hash &&
+    (url.protocol === "https:" || (url.protocol === "http:" && ["localhost", "127.0.0.1", "[::1]"].includes(url.hostname)))
+}, "Use HTTPS ou HTTP local, sem credenciais na URL")
+export const configSchema = z.object({
+  version: z.literal(1),
+  reflex: reflexConfigSchema.default(defaultReflex()),
+  providers: z.array(z.object({ id, name, kind: z.enum(["xiaomi", "openrouter", "huggingface", "ollama", "compatible", "minimax"]), baseUrl: endpoint })).max(32),
+  models: z.array(z.object({ id, name, providerId: id, model: z.string().regex(/^[a-zA-Z0-9][a-zA-Z0-9_./:@+-]{0,255}$/), capabilities: z.array(z.enum(purposes)).min(1), context: z.number().int().min(1024).max(4000000), output: z.number().int().min(128).max(1000000) })).max(128),
+  assignments: z.object(Object.fromEntries(purposes.map(p => [p, (p === "design" || p === "music") ? id.nullable().default(null) : id.nullable()])) as Record<Purpose, z.ZodNullable<typeof id> | z.ZodDefault<z.ZodNullable<typeof id>>>),
+  externalMCP: z.array(z.object({
+    id, name, url: endpoint, enabled: z.boolean(), authentication: z.enum(["none", "bearer"]),
+    agents: mcpAgents,
+  })).max(24).default([]),
+  localMCP: z.array(z.object({ id, name, command, enabled: z.boolean(), agents: mcpAgents })).max(24).default([]),
+  operator: z.object({
+    questioning: z.enum(questioningModes).default("adaptive"),
+    models: z.object(Object.fromEntries(agentIds.map(agent => [agent, id.nullable().default(null)])) as Record<AgentId, z.ZodDefault<z.ZodNullable<typeof id>>>).default(Object.fromEntries(agentIds.map(agent => [agent, null])) as Record<AgentId, null>),
+  }).default({ questioning: "adaptive", models: Object.fromEntries(agentIds.map(agent => [agent, null])) as Record<AgentId, null> }),
+}).superRefine((config, ctx) => {
+  for (const [key, list] of [["providers", config.providers], ["models", config.models], ["externalMCP", [...config.externalMCP, ...config.localMCP]]] as const) {
+    if (new Set(list.map(x => x.id)).size !== list.length) ctx.addIssue({ code: "custom", path: [key], message: "IDs duplicados" })
+  }
+  for (const model of config.models) {
+    if (!config.providers.some(p => p.id === model.providerId)) ctx.addIssue({ code: "custom", message: "Provedor do modelo não existe" })
+    if (model.output > model.context) ctx.addIssue({ code: "custom", message: "Saída maior que o contexto" })
+  }
+  for (const purpose of purposes) {
+    const selected = config.assignments[purpose]
+    if (selected && !config.models.some(m => m.id === selected && m.capabilities.includes(purpose))) ctx.addIssue({ code: "custom", path: ["assignments", purpose], message: "Modelo não atende a finalidade selecionada" })
+  }
+  for (const agent of agentIds) {
+    const selected = config.operator.models[agent]
+    if (selected && !config.models.some(m => m.id === selected && m.capabilities.includes(agents[agent].purpose))) ctx.addIssue({ code: "custom", path: ["operator", "models", agent], message: "Modelo não atende ao agente selecionado" })
+  }
+})
+export type ModelConfig = z.infer<typeof configSchema>
+export type PublicConfig = ModelConfig & { keys: Record<string, boolean>; mcpKeys: Record<string, boolean>; reflexKey: boolean }
+export const externalMCPName = (id: string) => `nebula_external_${id.length}_${id}`
+export const mcpConnections = (config: ModelConfig) => [...config.externalMCP, ...config.localMCP]
+export function localMCPActivations(previous: ModelConfig, next: ModelConfig) {
+  return next.localMCP.filter(server => server.enabled && !previous.localMCP.some(saved => saved.id === server.id && saved.enabled && JSON.stringify(saved.command) === JSON.stringify(server.command) && server.agents.every(agent => saved.agents.includes(agent))))
+}
+export const defaultConfig = (): ModelConfig => ({
+  version: 1,
+  reflex: defaultReflex(),
+  providers: [{ id: "nebula_xiaomi", name: "Xiaomi MiMo", kind: "xiaomi", baseUrl: providers.xiaomi.url }],
+  models: [{ id: "mimo_default", name: "MiMo", providerId: "nebula_xiaomi", model: "mimo-v2.6-flash", capabilities: ["code", "text", "research"], context: 131072, output: 8192 }],
+  assignments: { code: "mimo_default", text: "mimo_default", research: "mimo_default", image: null, video: null, vision: null, design: null, music: null },
+  externalMCP: [],
+  localMCP: [],
+  operator: { questioning: "adaptive", models: Object.fromEntries(agentIds.map(agent => [agent, null])) as Record<AgentId, null> },
+})
+export function resolveModel(config: ModelConfig, purpose: Purpose) {
+  const model = config.models.find(m => m.id === config.assignments[purpose] && m.capabilities.includes(purpose))
+  const provider = config.providers.find(p => p.id === model?.providerId)
+  if (!model || !provider) throw new Error(`Configure um modelo para ${labels[purpose].toLowerCase()}`)
+  return { model, provider }
+}
+export function resolveAgentModel(config: ModelConfig, agent: AgentId) {
+  const selected = config.operator.models[agent]
+  if (!selected) return resolveModel(config, agents[agent].purpose)
+  const model = config.models.find(m => m.id === selected && m.capabilities.includes(agents[agent].purpose))
+  const provider = config.providers.find(p => p.id === model?.providerId)
+  if (!model || !provider) throw new Error(`Configure um modelo para ${agents[agent].name}`)
+  return { model, provider }
+}
+export function engineConfig(config: ModelConfig, operator?: { url: string; token: string }) {
+  const chat = config.models.filter(m => m.capabilities.some(p => ["code", "text", "research", "vision"].includes(p)))
+  const localEnvironment = Object.fromEntries(["MIMOCODE_AUTH_CONTENT", "MIMOCODE_CONFIG_CONTENT", "MIMOCODE_SERVER_PASSWORD", ...config.providers.map(provider => `NEBULA_TOKEN_${provider.id}`), ...config.externalMCP.map(server => `NEBULA_MCP_TOKEN_${server.id}`)].map(key => [key, ""]))
+  return {
+    autoupdate: false, share: "disabled", plugin: [], mcp: { ...Object.fromEntries(config.externalMCP.map(server => [externalMCPName(server.id), { type: "remote", url: server.url, enabled: server.enabled, oauth: false, timeout: 15000, ...(server.authentication === "bearer" ? { headers: { Authorization: `{env:NEBULA_MCP_TOKEN_${server.id}}` } } : {}) }])), ...Object.fromEntries(config.localMCP.map(server => [externalMCPName(server.id), { type: "local", command: server.command, environment: localEnvironment, enabled: server.enabled, timeout: 15000 }])), ...(operator ? { nebula_operator: { type: "remote", url: operator.url, headers: { Authorization: `Bearer ${operator.token}` }, oauth: false, enabled: true, timeout: 30000 } } : {}) },
+    enabled_providers: config.providers.map(p => p.id),
+    model: chat[0] ? `${chat[0].providerId}/${chat[0].model}` : undefined,
+    small_model: chat[0] ? `${chat[0].providerId}/${chat[0].model}` : undefined,
+    permission: { "*": "ask", external_directory: "deny", bash_interactive: "deny", doom_loop: "deny", ...Object.fromEntries(mcpConnections(config).map(server => [externalMCPName(server.id) + "_*", "deny"])) },
+    agent: {
+      nebula_editor_explain: { description: "Explicação de código do Editor Nebula somente de leitura", mode: "primary", prompt: agentPrompt("development", config.operator.questioning) + "\nExplique o contexto enviado pelo editor. Não edite arquivos nem execute comandos.", permission: { "*": "deny", question: "allow", read: "ask", glob: "ask", grep: "ask" } },
+      build: { prompt: agentPrompt("development", config.operator.questioning), permission: { question: "allow" } },
+      ...Object.fromEntries(agentIds.flatMap(id => {
+        const agent = agents[id]
+        const selected = config.operator.models[id] ?? config.assignments[agent.purpose]
+        const model = config.models.find(m => m.id === selected)
+        const basePermission = id === "writing" || id === "vision" ? { "*": "deny", question: "allow" }
+          : id === "browser" || id === "research" ? { "*": "deny", question: "allow", webfetch: "ask", websearch: "ask", read: "ask", glob: "ask", grep: "ask", "nebula_operator_browser_*": "ask" }
+          : { "*": "ask", question: "allow", external_directory: "deny", bash_interactive: "deny", doom_loop: "deny" }
+        const permission = { ...basePermission, ...Object.fromEntries(mcpConnections(config).map(server => [externalMCPName(server.id) + "_*", server.enabled && server.agents.includes(id) ? "ask" : "deny"])) }
+        const available = specialistIds.filter(specialist => {
+          const selected = config.operator.models[specialist] ?? config.assignments[agents[specialist].purpose]
+          return config.models.some(model => model.id === selected)
+        })
+        const prompt = agentPrompt(id, config.operator.questioning) + (id === "coordinator" ? "\n\nEspecialistas configurados para actor (subagent_type):\n" + available.map(specialist => `${specialistEngine(specialist)}: ${agents[specialist].name} — ${agents[specialist].description}`).join("\n") : "")
+        const profile = { description: agent.description, mode: id === "coordinator" ? "primary" : "all", prompt, permission: id === "coordinator" ? { ...permission, actor: { "*": "deny", ...Object.fromEntries(available.map(specialist => [specialistEngine(specialist), "ask"])) } } : permission, ...(model ? { model: `${model.providerId}/${model.model}` } : {}) }
+        if (id === "coordinator" || !model) return [[agent.engine, profile]]
+        return [[agent.engine, profile], [specialistEngine(id), { ...profile, mode: "subagent", prompt: prompt + "\n\nVocê executa uma tarefa delegada. O briefing contém as decisões e o escopo já autorizados: não repita a entrevista. Complete somente sua responsabilidade, relate evidências e indique perguntas novas indispensáveis. Você não pode delegar para outros agentes.", permission: { ...permission, actor: "deny" } }]]
+      })),
+    },
+    provider: Object.fromEntries(config.providers.map(p => [p.id, {
+      npm: "@ai-sdk/openai-compatible", name: p.name, options: { baseURL: p.baseUrl, apiKey: `{env:NEBULA_TOKEN_${p.id}}` },
+      models: Object.fromEntries(chat.filter(m => m.providerId === p.id).map(m => [m.model, { name: m.name, attachment: m.capabilities.includes("vision"), modalities: { input: m.capabilities.includes("vision") ? ["text", "image"] : ["text"], output: ["text"] }, limit: { context: m.context, output: m.output } }])),
+    }])),
+  }
+}
+
+export const purposeSchema = z.enum(purposes)
