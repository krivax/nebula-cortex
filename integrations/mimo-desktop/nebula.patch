@@ -0,0 +1,12 @@
+import { posix, win32 } from "node:path"
+
+export const nodeExecutable = (platform = process.platform) => platform === "win32" ? "node/node.exe" : "node/bin/node"
+export const engineExecutable = (platform = process.platform) => platform === "win32" ? "bin/mimo.exe" : "bin/mimo"
+export function outsideProject(path: string, platform = process.platform) {
+  return path === ".." || /^\.\.[\\/]/.test(path) || (platform === "win32" ? win32 : posix).isAbsolute(path)
+}
+export function projectRelative(root: string, file: string, platform = process.platform) {
+  const path = (platform === "win32" ? win32 : posix).relative(root, file)
+  if (!path || outsideProject(path, platform)) throw new Error("O arquivo deve pertencer ao projeto aberto")
+  return path
+}
