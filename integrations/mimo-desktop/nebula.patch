+import { writeFile } from "node:fs/promises"
+import { agentIds } from "../../../app/src/nebula/agents"
+import { localReflex, localReflexVersion } from "../../../app/src/nebula/reflex"
+import { reflexCases, reflexRegressionCases } from "./reflex-cases"
+
+const samples = reflexCases.map(sample => {
+  const start = performance.now()
+  const result = localReflex(sample, agentIds)
+  return { ...sample, actual: result.agent, ms: performance.now() - start }
+})
+const timings = samples.map(sample => sample.ms).sort((a, b) => a - b)
+const percentile = (p: number) => timings[Math.ceil(timings.length * p) - 1].toFixed(3)
+const rows = [...agentIds, "abstain"].map(category => {
+  const expected = category === "abstain" ? null : category
+  const cases = samples.filter(sample => sample.expected === expected)
+  const tp = cases.filter(sample => sample.actual === expected).length
+  const predicted = samples.filter(sample => sample.actual === expected).length
+  const f1 = predicted + cases.length ? 2 * tp / (predicted + cases.length) : 0
+  return `| ${category} | ${cases.length} | ${tp} | ${(100 * f1).toFixed(1)}% |`
+})
+const mistakes = samples.filter(sample => sample.actual !== sample.expected)
+const regressions = reflexRegressionCases.map(sample => ({ ...sample, result: localReflex(sample, sample.available ?? agentIds) }))
+const failedRegressions = regressions.filter(sample => sample.result.agent !== sample.expected || (sample.clarification && sample.result.clarification !== sample.clarification))
+const regressionRows = ["objective", "steps", "availability", "context"].map(group => {
+  const cases = regressions.filter(sample => sample.id.startsWith(group + "-"))
+  const failures = failedRegressions.filter(sample => sample.id.startsWith(group + "-"))
+  return `| ${group} | ${cases.length} | ${cases.length - failures.length} |`
+})
+const report = `# Nebula Reflex — avaliação local\n\nRegras: **${localReflexVersion}**. Conjunto sintético de desenvolvimento v1: ${samples.length} pedidos em português. Criado durante a implementação, sem dados de usuários. As regras foram ajustadas usando esse conjunto: não é um teste independente nem estima desempenho em produção. Todos os especialistas foram considerados disponíveis no conjunto original.\n\nRegras locais: ${samples.length - mistakes.length}/${samples.length} escolhas iguais à categoria esperada. Abstenções: ${samples.filter(sample => !sample.actual).length}. Tempo da função local: p50 ${percentile(0.5)} ms; p95 ${percentile(0.95)} ms. Isso exclui IPC, disco, interface e rede. Custo de API: zero.\n\n| Categoria | Casos | Escolhas esperadas | F1 |\n|---|---:|---:|---:|\n${rows.join("\n")}\n\n## Divergências no conjunto original\n\n${mistakes.length ? mistakes.map(sample => `- ${sample.id}: esperado ${sample.expected ?? "abstain"}; sugerido ${sample.actual ?? "abstain"}.`).join("\n") : "Nenhuma nesta execução."}\n\nA primeira versão teve 161/165 correspondências. As quatro divergências (development-10, development-18, writing-15 e writing-17) motivaram ajustes em verbos, objetivo principal e restrições. Esta melhora mede regressão nesse conjunto conhecido, não generalização.\n\n## Casos adicionais de regressão\n\n${regressions.length - failedRegressions.length}/${regressions.length} casos corresponderam ao agente e, quando especificada, à pergunta esperada. Estes casos também foram criados durante a implementação. Incluem objetivos com assuntos de outra especialidade, anexos, código e citações, etapas distintas, objetivos vagos e especialistas indisponíveis. O filtro de disponibilidade é exercitado diretamente.\n\n| Grupo | Casos | Correspondências |\n|---|---:|---:|\n${regressionRows.join("\n")}\n\n${failedRegressions.length ? failedRegressions.map(sample => `- ${sample.id}: esperado ${sample.expected ?? "abstain"}/${sample.clarification ?? "qualquer pergunta"}; sugerido ${sample.result.agent ?? "abstain"}/${sample.result.clarification}.`).join("\n") : "Nenhuma divergência nos casos adicionais nesta execução."}\n\n## Decisão\n\nO modo local já permite testar a orientação sem custo. Ainda depende de regras limitadas de linguagem: mantenha revisão humana e abstenção. Clef-flash permanece opcional: o adaptador foi testado com HTTP sintético no formato oficial, sem medir o modelo hospedado. Não há evidência própria de que Clef supera estas regras. Antes de promovê-lo, comparar uma amostra nova revisada por usuários, medir erros, abstenções, calibração, latência completa e custo. Os limiares atuais (pontuação configurável, margem 0,15) são provisórios.\n`
+if (!process.argv[2]) throw new Error("Informe o arquivo de relatório")
+await writeFile(process.argv[2], report)
+console.log(JSON.stringify({ rules: localReflexVersion, cases: samples.length, matched: samples.length - mistakes.length, mismatches: mistakes.map(sample => sample.id), regressions: regressions.length, regressionFailures: failedRegressions.map(sample => sample.id) }))
+if (mistakes.length || failedRegressions.length) process.exitCode = 1
diff --git a/packages/desktop/src/nebula/reflex.test.ts b/packages/desktop/src/nebula/reflex.test.ts
new file mode 100644
index 0000000..b6f0489
--- /dev/null
+++ b/packages/desktop/src/nebula/reflex.test.ts
@@ -0,0 +1,112 @@
+import { describe, expect, test } from "bun:test"
+import { createServer } from "node:http"
+import { agentIds } from "../../../app/src/nebula/agents"
+import { defaultReflex, localReflex, localReflexVersion, reflexConfigSchema, clarificationIds, parseReflexResponse, reflexQuestions } from "../../../app/src/nebula/reflex"
+import { configSchema, defaultConfig, engineConfig } from "./config"
+import { requestReflex, reflexTarget, decodeReflexResponse } from "./reflex-client"
+import { reflexRegressionCases } from "./reflex-cases"
+
+function answer(options: readonly string[], selected: string, probability = 0.94) {
+  return { type: "choice", choice: selected, confidence: probability, probabilities: Object.fromEntries(options.map(key => [key, key === selected ? probability : (1 - probability) / (options.length - 1)])) }
+}
+const response = () => ({ model: "clef-flash", answers: { agent: answer([...agentIds, "abstain"], "development"), clarification: answer(clarificationIds, "scope") } })
+describe("Nebula Reflex decisions", () => {
+  test("legacy settings gain local-only orientation without adding engine tools", () => {
+    const original = defaultConfig()
+    const { reflex: _, ...legacy } = original
+    const migrated = configSchema.parse(legacy)
+    expect(migrated.reflex.provider).toBe("local")
+    expect(engineConfig(migrated)).toEqual(engineConfig({ ...migrated, reflex: { ...migrated.reflex, enabled: false } }))
+  })
+  test("Cloudflare uses the official endpoint and requires an account and Clef model", () => {
+    const config = { ...defaultReflex(), provider: "cloudflare" as const, accountId: "a".repeat(32) }
+    expect(reflexTarget(config)).toBe(`https://api.cloudflare.com/client/v4/accounts/${"a".repeat(32)}/ai/run/@cf/cloudflare/clef-flash`)
+    expect(reflexConfigSchema.safeParse({ ...config, accountId: "" }).success).toBe(false)
+    expect(reflexConfigSchema.safeParse({ ...config, model: "test/model" }).success).toBe(false)
+    for (const endpoint of ["http://example.com/v1/systemone", "https://example.com?key=example", "https://user:example@example.com", "file:///tmp/example"]) expect(reflexConfigSchema.safeParse({ ...defaultReflex(), endpoint }).success).toBe(false)
+  })
+  test("local suggestions preserve uncertainty and only name available specialists", () => {
+    expect(localReflex({ text: "Corrija o bug na função em Rust", hasImages: false }, agentIds).agent).toBe("development")
+    expect(localReflex({ text: "Corrija o bug na função em Rust", hasImages: false }, ["writing"]).agent).toBeNull()
+    expect(localReflex({ text: "continue", hasImages: false }, agentIds).agent).toBeNull()
+    const result = localReflex({ text: "Verifique o botão de login", hasImages: false }, agentIds)
+    expect(result.agent).toBe("browser"); expect(result.clarification).toBe("url"); expect(result.confidence).toBeNull()
+    expect(localReflex({ text: "Analise a imagem", hasImages: false }, agentIds).clarification).toBe("image")
+    expect(localReflex({ text: "Crie uma imagem de um jardim", hasImages: false }, agentIds).agent).toBeNull()
+  })
+  for (const group of ["objective", "steps", "availability", "context"]) test(`local orientation handles ${group} regressions without granting tools`, () => {
+    for (const sample of reflexRegressionCases.filter(sample => sample.id.startsWith(group + "-"))) {
+      const result = localReflex(sample, sample.available ?? agentIds)
+      expect(result.agent, sample.text).toBe(sample.expected)
+      if (sample.clarification) expect(result.clarification, sample.text).toBe(sample.clarification)
+      expect(result.confidence).toBeNull()
+      expect(result.rulesVersion).toBe(localReflexVersion)
+    }
+  })
+  test("the typed schema offers abstenção and never exposes execution tools", () => {
+    const questions = reflexQuestions(["development"])
+    expect(Object.keys(questions.agent.criteria)).toEqual(["development", "abstain"])
+    expect(JSON.stringify(questions)).not.toContain("tool_calls")
+  })
+  test("valid official-shaped probabilities produce a bounded suggestion", () => {
+    const result = parseReflexResponse(response(), agentIds, 0.75)
+    expect(result.agent).toBe("development"); expect(result.clarification).toBe("scope")
+    expect(Object.keys(result)).not.toContain("permission")
+  })
+  test("the Cloudflare REST envelope and token usage are validated without a paid request", () => {
+    const config = { ...defaultReflex(), provider: "cloudflare" as const, accountId: "a".repeat(32) }
+    const result = decodeReflexResponse(config, { success: true, result: { ...response(), usage: { input_tokens: 1234, output_tokens: 0 } } }, agentIds)
+    expect(result.agent).toBe("development"); expect(result.classifierModel).toBe("clef-flash"); expect(result.inputTokens).toBe(1234)
+    expect(() => decodeReflexResponse(config, { success: false, result: response() }, agentIds)).toThrow()
+    expect(() => decodeReflexResponse(config, { success: true, result: { ...response(), model: "other" } }, agentIds)).toThrow()
+  })
+  test("low confidence and explicit abstenção never select an agent", () => {
+    const value = response(); value.answers.agent = answer([...agentIds, "abstain"], "development", 0.6)
+    expect(parseReflexResponse(value, agentIds, 0.75).agent).toBeNull()
+    value.answers.agent = answer([...agentIds, "abstain"], "abstain")
+    expect(parseReflexResponse(value, agentIds, 0.75).agent).toBeNull()
+  })
+  test("invalid options, distributions, unbounded output and forged choice are rejected", () => {
+    const invalid = [
+      { ...response(), answers: { ...response().answers, agent: { ...response().answers.agent, type: "score" } } },
+      { ...response(), answers: { ...response().answers, agent: { choice: "execute", probabilities: { execute: 1 } } } },
+      { ...response(), answers: { ...response().answers, agent: { ...response().answers.agent, choice: "browser" } } },
+      { ...response(), answers: { ...response().answers, clarification: { choice: "scope", probabilities: { scope: 1 } } } },
+    ]
+    for (const value of invalid) expect(() => parseReflexResponse(value, agentIds, 0.75)).toThrow()
+    const value = response(); value.answers.agent.probabilities.development = 2
+    expect(() => parseReflexResponse(value, agentIds, 0.75)).toThrow()
+  })
+  test("the SystemOne adapter sends only typed text state and reads the real HTTP response", async () => {
+    let observed: unknown
+    const server = createServer(async (req, res) => {
+      let text = ""; for await (const chunk of req) text += chunk
+      observed = { path: req.url, auth: req.headers.authorization, body: JSON.parse(text) }
+      res.setHeader("Content-Type", "application/json"); res.end(JSON.stringify(response()))
+    })
+    await new Promise<void>(resolve => server.listen(0, "127.0.0.1", resolve))
+    try {
+      const endpoint = `http://127.0.0.1:${(server.address() as { port: number }).port}/v1/systemone`
+      const config = { ...defaultReflex(), provider: "systemone" as const, endpoint }
+      expect((await requestReflex(config, { text: "Corrija o erro no exemplo", hasImages: true }, agentIds, "test-token")).agent).toBe("development")
+      expect(observed).toEqual({ path: "/v1/systemone", auth: "Bearer test-token", body: { model: "clef-flash", state: { request: "Corrija o erro no exemplo", hasImages: true }, questions: reflexQuestions(agentIds) } })
+      await expect(requestReflex(config, { text: "x".repeat(4097), hasImages: false }, agentIds)).rejects.toThrow()
+    } finally { server.closeAllConnections(); await new Promise<void>(resolve => server.close(() => resolve())) }
+  })
+  test("redirects, oversized responses, HTTP errors and timeouts fail without retrying", async () => {
+    let mode = "redirect", calls = 0
+    const server = createServer((_req, res) => {
+      calls += 1
+      if (mode === "redirect") { res.writeHead(302, { Location: "https://example.com" }); res.end(); return }
+      if (mode === "large") { res.end("x".repeat(65537)); return }
+      if (mode === "http") { res.writeHead(401); res.end("test-token"); return }
+      if (mode === "invalid") { res.end(JSON.stringify({ success: true, result: response() })); return }
+    })
+    await new Promise<void>(resolve => server.listen(0, "127.0.0.1", resolve))
+    try {
+      const config = { ...defaultReflex(), provider: "systemone" as const, timeoutMs: 500, endpoint: `http://127.0.0.1:${(server.address() as { port: number }).port}/v1/systemone` }
+      for (mode of ["redirect", "large", "http", "invalid", "timeout"]) await expect(requestReflex(config, { text: "Corrija o exemplo", hasImages: false }, agentIds)).rejects.toThrow()
+      expect(calls).toBe(5)
+    } finally { server.closeAllConnections(); await new Promise<void>(resolve => server.close(() => resolve())) }
+  })
+})
