@@ -0,0 +1,34 @@
+import { createSignal, Show } from "solid-js"
+import { Dialog } from "@mimo-ai/ui/dialog"
+import { Button } from "@mimo-ai/ui/button"
+import { useDialog } from "@mimo-ai/ui/context/dialog"
+import type { Mission } from "@/nebula/missions"
+
+export function MissionDialog(props: { mission: Mission; action: "edit" | "remove"; save: (goal: string) => Promise<void> }) {
+  const dialog = useDialog()
+  const [goal, setGoal] = createSignal(props.mission.objective)
+  const [busy, setBusy] = createSignal(false)
+  const [error, setError] = createSignal("")
+  const editing = props.action === "edit"
+  async function save() {
+    if (busy() || (editing && !goal().trim())) return
+    setBusy(true); setError("")
+    try { await props.save(goal()); dialog.close() }
+    catch { setError(editing ? "Não foi possível salvar. Confira o objetivo ou atualize a lista de missões." : "Não foi possível remover. Atualize a lista de missões e tente novamente.") }
+    finally { setBusy(false) }
+  }
+  return <Dialog title={editing ? "Editar missão" : "Remover missão"} fit>
+    <form class="nebula-mission-dialog" onSubmit={event => { event.preventDefault(); void save() }}>
+      <Show when={editing} fallback={<><p>Remover a missão <strong>“{props.mission.objective}”</strong>?</p><p>O registro da missão será removido. A conversa e os arquivos do projeto serão preservados. Uma execução em andamento continuará na conversa.</p></>}>
+        <label for="nebula-mission-objective">Objetivo da missão</label>
+        <textarea id="nebula-mission-objective" autofocus required maxLength={8000} disabled={busy()} value={goal()} onInput={event => setGoal(event.currentTarget.value)} />
+        <p>{props.mission.sessionID ? "A edição altera o objetivo salvo. Para orientar o agente, envie uma nova mensagem na conversa; as mensagens já enviadas serão preservadas." : props.mission.action === "general" ? "O rascunho será atualizado para este objetivo. Revise antes de enviar." : "O rascunho será atualizado mantendo o código, as linhas e as restrições da ação do editor."}</p>
+      </Show>
+      <Show when={error()}><p class="nebula-delete-error" role="alert">{error()}</p></Show>
+      <div class="nebula-delete-actions">
+        <Button type="button" variant="ghost" autofocus={!editing} disabled={busy()} onClick={() => dialog.close()}>Cancelar</Button>
+        <Button type="submit" variant="primary" disabled={busy() || (editing && !goal().trim())}>{busy() ? editing ? "Salvando…" : "Removendo…" : editing ? "Salvar objetivo" : "Remover missão"}</Button>
+      </div>
+    </form>
+  </Dialog>
+}
